# Order book — kaikai + raylib showcase
#
# A live limit-order book with price-time priority matching.
# Two producer actors generate random buy / sell orders around
# the mid price; a matching-engine actor owns the book, crosses
# each incoming order against the opposite side and records the
# fills. The main fiber runs the raylib frame loop: it asks the
# engine for a snapshot every frame and paints the latest one it
# has received.
#
# Four layers, marked with banners:
#
#   1. ===== MODEL =====   types (Side, Order, Level, Fill, Book)
#                          and the pure matching kernel. No I/O,
#                          no mutation: every step returns a new
#                          Book.
#   2. ===== VIEW  =====   raylib rendering of a Book snapshot.
#                          Layout constants only here.
#   3. ===== ACTORS ====   the producers, the matching engine and
#                          the messages they exchange.
#   4. ===== UI    =====   the frame loop on the main fiber:
#                          input, snapshot, paint.
#
# Features showcased:
#
#   - Actors with private heaps:  each actor owns its state; the
#                                 only way to touch it is to send
#                                 it a message. The book lives in
#                                 the engine and nowhere else.
#   - Typed mailboxes:            the engine receives `EngineMsg`,
#                                 producers receive `Control`, the
#                                 UI receives `Book` snapshots; the
#                                 typer rejects a send of the wrong
#                                 shape.
#   - Request / reply:            `Snapshot(Actor.self())` carries
#                                 the UI's Pid so the engine knows
#                                 where to answer.
#   - Persistent data:            the book is plain lists and
#                                 records; matching is a recursive
#                                 function from Book to Book.
#
# Controles:
#   SPACE   pausa / reanuda la simulación
#   R       limpia el book y los fills
#   F       acelera el ritmo de órdenes
#   S       lo frena
#   ESC     salir

import ffi.raylib
import ffi.keys
import loop
import actor
import spawn
import time

# ============================================================
#  1. ===== MODEL ===============================================
#
#  Prices are in cents (Int) so we sidestep floating-point
#  comparison drift. Quantities are whole shares.
#
#  Bids are kept best-first (descending price), asks best-first
#  (ascending price). Fills are kept newest-first.
# ============================================================

type Side = Buy | Sell

type Order = { side: Side, price: Int, qty: Int }

type Level = { price: Int, qty: Int }

type Fill = { seq: Int, side: Side, price: Int, qty: Int }

type Book = {
  bids: [Level],
  asks: [Level],
  fills: [Fill],
  seq: Int,
  orders: Int,
  n_fills: Int,
  volume: Int
}

const n_levels : Int = 16  # top-of-book depth kept per side

const fills_shown : Int = 22  # fills kept for the recent-fills panel

const empty_book : Book = Book {
  bids: [],
  asks: [],
  fills: [],
  seq: 0,
  orders: 0,
  n_fills: 0,
  volume: 0
}

fn side_label(s: Side) : String = match s {
  Buy -> "BUY"
  Sell -> "SELL"
}

fn opposite(s: Side) : Side = match s {
  Buy -> Sell
  Sell -> Buy
}

# An incoming order at `price` crosses a resting level at `best`
# when the buyer pays at least the ask, or the seller accepts at
# most the bid.
fn crosses(side: Side, price: Int, best: Int) : Bool {
  case Buy, p, b -> p >= b
  case Sell, p, b -> p <= b
}

# `a` ranks ahead of `b` on this side of the book.
fn ranks_before(side: Side, a: Int, b: Int) : Bool {
  case Buy, a, b -> a > b
  case Sell, a, b -> a < b
}

fn levels_of(book: Book, s: Side) : [Level] = match s {
  Buy -> book.bids
  Sell -> book.asks
}

fn with_levels(book: Book, s: Side, levels: [Level]) : Book = match s {
  Buy -> Book { ...book, bids: levels }
  Sell -> Book { ...book, asks: levels }
}

# Add `qty` at `price` to a sorted side: merge into an existing
# level at that price, otherwise insert where the order ranks.
fn insert_level(side: Side, levels: [Level], price: Int, qty: Int) : [Level] =
  match levels {
    [] -> [Level { price, qty }]
    [l, ...rest] if l.price == price -> [Level { ...l, qty: l.qty + qty }, ...rest]
    [l, ...rest] if ranks_before(side, price, l.price) -> [Level { price, qty }, l, ...rest]
    [l, ...rest] -> [l, ...insert_level(side, rest, price, qty)]
  }

# Rest the unfilled part of an order on its own side. A full side
# keeps its best `n_levels`, so a price outside that window drops.
fn rest_order(book: Book, side: Side, price: Int, qty: Int) : Book =
  with_levels(book, side, insert_level(side, levels_of(book, side), price, qty).take(n_levels))

# Walk the top of the opposite side while the order crosses and
# still has quantity, one fill per level touched; whatever is left
# rests on the order's own side.
fn sweep(book: Book, side: Side, price: Int, qty: Int) : Book =
  match levels_of(book, opposite(side)) {
    [best, ...rest] if qty > 0 and crosses(side, price, best.price) -> {
      let take = min(qty, best.qty)
      let remaining =
        if take == best.qty { rest } else { [Level { ...best, qty: best.qty - take }, ...rest] }
      let fill = Fill { seq: book.seq, side, price: best.price, qty: take }
      let next = Book {
        ...with_levels(book, opposite(side), remaining),
        fills: [fill, ...book.fills].take(fills_shown),
        n_fills: book.n_fills + 1,
        volume: book.volume + take
      }
      sweep(next, side, price, qty - take)
    }
    _ -> if qty > 0 { rest_order(book, side, price, qty) } else { book }
  }

fn submit(book: Book, o: Order) : Book =
  sweep(Book { ...book, seq: book.seq + 1, orders: book.orders + 1 }, o.side, o.price, o.qty)

# Clear the book and the counters; the sequence keeps running so
# fill numbers stay unique across resets.
fn reset(book: Book) : Book = Book { ...empty_book, seq: book.seq }

# ============================================================
#  2. ===== VIEW ================================================
#
#  raylib rendering: the two book sides as ladders, last fills as
#  a panel, footer with stats. Reads a snapshot; never mutates.
# ============================================================

const width : Int = 1000

const height : Int = 640

const col_bg : Color = rgba(0x0a0e14FF)

const col_panel : Color = rgba(0x121822FF)

const col_text : Color = rgba(0xeaedf3FF)

const col_dim : Color = rgba(0x6b7382FF)

const col_bid : Color = rgba(0x4ec9b0FF)

const col_ask : Color = rgba(0xf28b82FF)

const col_accent : Color = rgba(0xfca311FF)

fn side_color(s: Side) : Color = match s {
  Buy -> col_bid
  Sell -> col_ask
}

# Cents as dollars with two decimals: 17505 -> "175.05".
fn money(cents: Int) : String = "#{cents / 100}.#{int_to_string(cents % 100).pad_left(2, '0')}"

# ----- book ladder layout -----

const bid_x : Int = 40

const ask_x : Int = 320

const ladder_y : Int = 100

const row_h : Int = 22

const ladder_w : Int = 240

const bar_h : Int = 16

fn draw_book_side(levels: [Level], x: Int, color: Color, label: String) : Unit / Ffi {
  raylib.draw_text(label, x, ladder_y - 24, 16, color)
  raylib.draw_text("price    qty   bar", x, ladder_y - 6, 11, col_dim)
  # Volume bars scale against the largest level on this side.
  let widest = max(1, levels | .qty |> max |> unwrap_or(0))
  foreach(levels.enumerate()) { (i, l) ->
    let y = ladder_y + 12 + i * row_h
    raylib.draw_rectangle(x - 4, y - 2, ladder_w + 8, row_h, col_panel)
    raylib.draw_text(money(l.price), x, y, 14, col_text)
    raylib.draw_text(int_to_string(l.qty), x + 64, y, 14, col_dim)
    raylib.draw_rectangle(x + 120, y + 2, l.qty * (ladder_w - 130) / widest, bar_h - 4, color)
  }
}

# ----- spread / mid -----

fn draw_spread(book: Book) : Unit / Ffi {
  let y = 40
  match (book.bids, book.asks) {
    ([bid, ..._], [ask, ..._]) -> {
      raylib.draw_text("MID", 40, y - 2, 12, col_dim)
      raylib.draw_text(money((bid.price + ask.price) / 2), 40, y + 12, 22, col_accent)
      raylib.draw_text("SPREAD", 220, y - 2, 12, col_dim)
      raylib.draw_text(money(ask.price - bid.price), 220, y + 12, 22, col_text)
    }
    _ -> raylib.draw_text("(book warming up...)", 40, y + 8, 16, col_dim)
  }
}

# ----- fills panel -----

const fills_x : Int = 620

const fills_y : Int = 100

const fills_w : Int = 340

const fills_rh : Int = 18

fn draw_fills(fills: [Fill]) : Unit / Ffi {
  raylib.draw_text("recent fills", fills_x, fills_y - 24, 16, col_text)
  raylib.draw_text("# seq    side  qty   price", fills_x, fills_y - 6, 11, col_dim)
  foreach(fills.enumerate()) { (k, f) ->
    let y = fills_y + 12 + k * fills_rh
    raylib.draw_rectangle(fills_x - 4, y - 2, fills_w + 8, fills_rh, col_panel)
    raylib.draw_text(int_to_string(f.seq), fills_x, y, 12, col_dim)
    raylib.draw_text(side_label(f.side), fills_x + 60, y, 12, side_color(f.side))
    raylib.draw_text(int_to_string(f.qty), fills_x + 110, y, 12, col_text)
    raylib.draw_text(money(f.price), fills_x + 170, y, 12, col_text)
  }
}

# ----- header / footer -----

fn draw_header(pace: Pace) : Unit / Ffi {
  raylib.draw_text("Order book  /  AAPL  /  kaikai + raylib + actors", 24, 8, 20, col_text)
  raylib.draw_text("SPACE pausa  R reset  F+ S- velocidad  ESC salir", 24, 580, 13, col_dim)
  if pace.paused {
    raylib.draw_text("PAUSADO", 660, 14, 14, col_accent)
  } else {
    raylib.draw_text("orders/s ~", 660, 14, 12, col_dim)
    raylib.draw_text(int_to_string(60 / pace.period), 730, 14, 12, col_text)
  }
}

fn draw_footer(book: Book) : Unit / Ffi {
  let y = height - 50
  raylib.draw_rectangle(24, y, width - 48, 30, col_panel)
  raylib.draw_text("orders", 40, y + 9, 12, col_dim)
  raylib.draw_text(int_to_string(book.orders), 90, y + 7, 14, col_text)
  raylib.draw_text("fills", 220, y + 9, 12, col_dim)
  raylib.draw_text(int_to_string(book.n_fills), 260, y + 7, 14, col_text)
  raylib.draw_text("volume", 400, y + 9, 12, col_dim)
  raylib.draw_text(int_to_string(book.volume), 460, y + 7, 14, col_text)
  let fill_rate = if book.orders == 0 { 0 } else { book.n_fills * 100 / book.orders }
  raylib.draw_text("fill rate %", 600, y + 9, 12, col_dim)
  raylib.draw_text(int_to_string(fill_rate), 690, y + 7, 14, col_accent)
}

fn draw_book(book: Book, pace: Pace) : Unit / Ffi {
  raylib.begin_drawing()
  raylib.clear_background(col_bg)
  draw_header(pace)
  draw_spread(book)
  draw_book_side(book.bids, bid_x, col_bid, "BIDS")
  draw_book_side(book.asks, ask_x, col_ask, "ASKS")
  draw_fills(book.fills)
  draw_footer(book)
  raylib.end_drawing()
}

# ============================================================
#  3. ===== ACTORS ==============================================
#
#  Each actor owns its state and changes it only in answer to a
#  message:
#
#    producer --Submit(order)--> engine
#    UI       --Reset---------> engine
#    UI       --Snapshot(me)--> engine --Book--> UI
#    UI       --SetPaused / SetPeriod--> producer
# ============================================================

type EngineMsg = Submit(Order) | Reset | Snapshot(Pid[Book])

type Control = SetPaused(Bool) | SetPeriod(Int)

# How a producer is pacing itself: whether it sends at all, and
# how many scheduler yields it waits between two orders.
type Pace = { paused: Bool, period: Int }

const initial_mid : Int = 17500  # 175.00

# ---- matching engine ----

fn matching_engine(book: Book) : Unit / Actor[EngineMsg] = match Actor.receive() {
  Submit(o) -> matching_engine(submit(book, o))
  Reset -> matching_engine(reset(book))
  Snapshot(to) -> {
    Actor.send(to, book)
    matching_engine(book)
  }
}

# ---- producers ----

# Buyers lean slightly below the mid, sellers slightly above, so
# the book stays centred instead of running away in one direction.
fn bias(s: Side) : Int = match s {
  Buy -> -2
  Sell -> 2
}

fn drifted_price(seed: Int, mean: Int) : Int / Ffi {
  let noise = raylib.get_random_value(-80, 80)  # ±80 cents
  mean + seed * 5 + noise  # ±0.20 mean offset
}

fn random_qty() : Int / Ffi {
  let r = raylib.get_random_value(0, 99)
  if r < 70 {
    raylib.get_random_value(10, 49)
  } else if r < 95 {
    raylib.get_random_value(50, 199)
  } else {
    raylib.get_random_value(200, 800)
  }
}

fn random_order(side: Side) : Order / Ffi {
  let price = drifted_price(bias(side), initial_mid)
  let qty = random_qty()
  Order { side, price, qty }
}

# Apply every control message already waiting, without blocking.
fn apply_controls(pace: Pace) : Pace / Actor[Control] = match receive_timeout(nanos_dur(0)) {
  None -> pace
  Some(SetPaused(p)) -> apply_controls(Pace { ...pace, paused: p })
  Some(SetPeriod(n)) -> apply_controls(Pace { ...pace, period: n })
}

# Cooperative pacing: yield `n` times before the next order.
fn burn_cycles(n: Int) : Unit / Spawn {
  if n > 0 {
    spawn.yield()
    burn_cycles(n - 1)
  }
}

fn producer(side: Side, engine: Pid[EngineMsg], pace: Pace) : Unit / Actor[Control] + Spawn + Ffi {
  let now = apply_controls(pace)
  if not now.paused {
    Actor.send(engine, Submit(random_order(side)))
  }
  burn_cycles(now.period)
  spawn.yield()
  producer(side, engine, now)
}

# ============================================================
#  4. ===== UI ==================================================
#
#  The frame loop is the main fiber. Each frame it reads the
#  keys, forwards any change to the actors, keeps the newest
#  snapshot that has arrived and asks for the next one. The
#  engine answers between frames, so what is painted is at most
#  one frame old.
# ============================================================

const min_period : Int = 2

const max_period : Int = 60

const default_period : Int = 12

fn read_keys(pace: Pace) : Pace / Ffi {
  let paused = if raylib.is_key_pressed(key_space) { not pace.paused } else { pace.paused }
  let faster = raylib.is_key_pressed(key_f) and pace.period > min_period
  let slower = raylib.is_key_pressed(key_s) and pace.period < max_period
  let period = pace.period + (if faster { -2 } else { 0 }) + (if slower { 2 } else { 0 })
  Pace { paused, period }
}

fn tell_producers(producers: [Pid[Control]], before: Pace, after: Pace) : Unit / Actor[Book] {
  if after.paused != before.paused {
    producers |! Actor.send(., SetPaused(after.paused))
  }
  if after.period != before.period {
    producers |! Actor.send(., SetPeriod(after.period))
  }
}

# The newest snapshot waiting in the mailbox, or `current` if
# none has arrived since the last frame.
fn latest(current: Book) : Book / Actor[Book] = match receive_timeout(nanos_dur(0)) {
  None -> current
  Some(b) -> latest(b)
}

fn frame_loop(
  engine: Pid[EngineMsg],
  producers: [Pid[Control]],
  start: Pace
) : Unit / Actor[Book] + Ffi + Spawn {
  var pace := start
  var book := empty_book
  until { raylib.window_should_close() } {
    let next = read_keys(pace)
    tell_producers(producers, pace, next)
    pace := next
    if raylib.is_key_pressed(key_r) {
      Actor.send(engine, Reset)
    }

    book := latest(book)
    Actor.send(engine, Snapshot(Actor.self()))
    draw_book(book, pace)

    # Give the producers and the engine room to run.
    spawn.yield()
  }
}

fn run() : Unit / Ffi + Spawn {
  let start = Pace { paused: false, period: default_period }
  let engine = spawn_actor(() => matching_engine(empty_book))
  let producers = [Buy, Sell] | (s => spawn_actor(() => producer(s, engine, start)))
  with_mailbox { frame_loop(engine, producers, start) }
}

fn main() : Int / Ffi + Spawn {
  raylib.set_random_seed(7)
  raylib.init_window(width, height, "Order book / kaikai + raylib + actors")
  raylib.set_target_fps(60)

  run()

  raylib.close_window()
  0
}

# ============================================================
#  Tests for the matching kernel
# ============================================================

fn book_of(orders: [Order]) : Book = orders |> foldl(empty_book, submit)

test "a resting order sits on its own side, best first" {
  let b =
    book_of([Order { side: Buy, price: 100, qty: 5 }, Order { side: Buy, price: 101, qty: 3 }])
  assert b.bids == [Level { price: 101, qty: 3 }, Level { price: 100, qty: 5 }]
  assert b.asks == []
}

test "same price merges into one level" {
  let b =
    book_of([Order { side: Sell, price: 200, qty: 5 }, Order { side: Sell, price: 200, qty: 2 }])
  assert b.asks == [Level { price: 200, qty: 7 }]
}

test "a crossing buy sweeps asks best-first and rests the residual" {
  let b = book_of([
    Order { side: Sell, price: 101, qty: 4 },
    Order { side: Sell, price: 100, qty: 3 },
    Order { side: Buy, price: 101, qty: 10 }
  ])
  assert b.asks == []
  assert b.bids == [Level { price: 101, qty: 3 }]
  assert b.fills
    == [
      Fill { seq: 3, side: Buy, price: 101, qty: 4 },
      Fill { seq: 3, side: Buy, price: 100, qty: 3 }
    ]
  assert b.n_fills == 2
  assert b.volume == 7
}

test "a partial fill leaves the rest of the level" {
  let b =
    book_of([Order { side: Buy, price: 100, qty: 10 }, Order { side: Sell, price: 99, qty: 4 }])
  assert b.bids == [Level { price: 100, qty: 6 }]
  assert b.asks == []
}

test "a full side keeps only its best levels" {
  let b = [1..20] | (p => Order { side: Buy, price: p, qty: 1 }) |> book_of
  assert b.bids.length() == n_levels
  assert (b.bids | .price |> max) == Some(20)
  assert (b.bids | .price |> min) == Some(5)
}

test "reset clears the book but keeps the sequence" {
  let b = reset(book_of([Order { side: Buy, price: 100, qty: 1 }]))
  assert b.bids == [] and b.orders == 0
  assert b.seq == 1
}

test "money pads the cents" {
  assert money(17505) == "175.05"
  assert money(17550) == "175.50"
}
