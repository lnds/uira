# Snake — kaikai + raylib showcase
#
# 32x24 grid, 25 px per cell (800x600 window). Classic rules:
# eat the apple to grow, lose by hitting a wall or your own body.
#
# The file is laid out in three layers so the game rules read
# separately from the rendering and the per-frame plumbing:
#
#   1. ===== MODEL =====   game rules: direction encoding,
#                          movement deltas, collision tests.
#                          Pure functions over the body buffer.
#   2. ===== STATE =====   the body ring buffer, apple position,
#                          score / game-over flags. All in
#                          Ref cells (state crosses function
#                          boundaries). Reset, step, and input
#                          buffering live here.
#   3. ===== VIEW  =====   raylib rendering. Reads body / apple
#                          / hud state; never mutates.
#
# Controls:
#   arrows   turn
#   R        restart
#   ESC      quit

import ffi.raylib
import ffi.keys
import loop

# ============================================================
#  1. ===== MODEL ===============================================
#
#  Direction encoding, dx/dy lookups, body-occupancy queries.
#  Everything in this section is referentially transparent —
#  feed it body coordinates, get back a Bool / Int / movement
#  delta. No state mutation across boundaries.
# ============================================================

const cols : Int = 32

const rows : Int = 24

# The body can at most fill the whole grid.
const max_body : Int = cols * rows

type Dir = Right | Down | Left | Up

fn dx_of(d: Dir) : Int {
  case Right -> 1
  case Left -> -1
  case _ -> 0
}

fn dy_of(d: Dir) : Int {
  case Down -> 1
  case Up -> -1
  case _ -> 0
}

# A turn is legal if it isn't a 180° flip on the current heading.
# We compare the *current* direction (already committed) against
# the requested one — so if the player double-taps in the same
# step, the second tap is correctly rejected.
fn legal_turn(current: Dir, requested: Dir) : Bool {
  case Right, Left -> false
  case Left, Right -> false
  case Down, Up -> false
  case Up, Down -> false
  case _, _ -> true
}

# Walk the body ring from `i` to `end_idx` (inclusive) and
# return true if any cell holds (x, y).
fn cell_in_body_range(
  body_x: Array[Int],
  body_y: Array[Int],
  i: Int,
  end_idx: Int,
  x: Int,
  y: Int
) : Bool {
  if body_x[i] == x and body_y[i] == y {
    true
  } else if i == end_idx {
    false
  } else {
    let next = (i + 1) % max_body
    cell_in_body_range(body_x, body_y, next, end_idx, x, y)
  }
}

fn cell_in_body(
  body_x: Array[Int],
  body_y: Array[Int],
  head_idx: Int,
  tail_idx: Int,
  x: Int,
  y: Int
) : Bool =
  cell_in_body_range(body_x, body_y, tail_idx, head_idx, x, y)

# A coord is on-screen iff it lies inside the grid.
fn in_bounds(x: Int, y: Int) : Bool =
  x >= 0 and x < cols and y >= 0 and y < rows

# ============================================================
#  2. ===== STATE ===============================================
#
#  The snake body is two parallel Array[Int]s (length max_body)
#  used as a circular ring; tail_idx and head_idx wrap modulo
#  max_body. Length = (head_idx - tail_idx + max_body) % max_body
#  + 1. Growing on apple-eat is "advance head, don't advance tail";
#  every other step advances both.
#
#  All scalar state crosses function boundaries through Ref
#  cells (kaikai's `Mutable` discipline).
# ============================================================

# ----- random apple placement -----
#
# Pick a random cell that isn't occupied by the snake. With ≤768
# cells we just rejection-sample.
fn place_apple(
  body_x: Array[Int],
  body_y: Array[Int],
  head_idx: Int,
  tail_idx: Int,
  apple_x: Ref[Int],
  apple_y: Ref[Int]
) : Unit / Ffi + Mutable {
  let ax = raylib.get_random_value(0, cols - 1)
  let ay = raylib.get_random_value(0, rows - 1)
  if cell_in_body(body_x, body_y, head_idx, tail_idx, ax, ay) {
    place_apple(body_x, body_y, head_idx, tail_idx, apple_x, apple_y)
  } else {
    apple_x := ax
    apple_y := ay
  }
}

# ----- reset -----
#
# Snake starts as 3 cells stacked horizontally near the centre,
# facing right. Buffer slots 0, 1, 2 hold (tail, mid, head).
fn reset(
  body_x: Array[Int],
  body_y: Array[Int],
  head_idx: Ref[Int],
  tail_idx: Ref[Int],
  direction: Ref[Dir],
  pending_dir: Ref[Dir],
  apple_x: Ref[Int],
  apple_y: Ref[Int],
  score: Ref[Int],
  game_over: Ref[Bool]
) : Unit / Ffi + Mutable {
  body_x[0] := 14
  body_y[0] := 12
  body_x[1] := 15
  body_y[1] := 12
  body_x[2] := 16
  body_y[2] := 12
  tail_idx := 0
  head_idx := 2
  direction := Right
  pending_dir := Right
  score := 0
  game_over := false
  place_apple(
    body_x,
    body_y,
    @head_idx,
    @tail_idx,
    apple_x,
    apple_y
  )
}

# ----- input buffering -----
#
# Buffer the next direction; only commit it on the step boundary
# so a fast double-tap can't reverse the snake into itself. The
# legality check (legal_turn) lives in MODEL.
fn read_input(direction: Ref[Dir], pending_dir: Ref[Dir]) : Unit / Ffi + Mutable {
  let cur = @direction
  if raylib.is_key_pressed(key_left) and legal_turn(cur, Left) { pending_dir := Left }
  if raylib.is_key_pressed(key_right) and legal_turn(cur, Right) { pending_dir := Right }
  if raylib.is_key_pressed(key_up) and legal_turn(cur, Up) { pending_dir := Up }
  if raylib.is_key_pressed(key_down) and legal_turn(cur, Down) { pending_dir := Down }
}

# ----- step -----
#
# Commit pending_dir, project the head one cell forward, then:
#   1. wall collision → game over
#   2. ate apple? grow (head++, tail stays); place new apple
#   3. self-collision? (tested against the body excluding the
#      tail cell that is about to be vacated when not growing)
#      → game over
#   4. otherwise: advance head, advance tail
fn step(
  body_x: Array[Int],
  body_y: Array[Int],
  head_idx: Ref[Int],
  tail_idx: Ref[Int],
  direction: Ref[Dir],
  pending_dir: Ref[Dir],
  apple_x: Ref[Int],
  apple_y: Ref[Int],
  score: Ref[Int],
  game_over: Ref[Bool]
) : Unit / Ffi + Mutable {
  direction := @pending_dir
  let dir = @direction
  let head = @head_idx
  let hx = body_x[head] + dx_of(dir)
  let hy = body_y[head] + dy_of(dir)

  if not in_bounds(hx, hy) {
    game_over := true
  } else {
    let ate = hx == (@apple_x) and hy == (@apple_y)

    # When not growing, the current tail slot is about to be
    # vacated, so it's not a real obstacle. Skip it from the
    # self-collision test by starting one cell ahead.
    let tail = @tail_idx
    let effective_tail = if ate { tail } else { (tail + 1) % max_body }

    if cell_in_body_range(body_x, body_y, effective_tail, head, hx, hy) {
      game_over := true
    } else {
      let new_head = (head + 1) % max_body
      body_x[new_head] := hx
      body_y[new_head] := hy
      head_idx := new_head
      if ate {
        score := (@score) + 1
        place_apple(body_x, body_y, new_head, tail, apple_x, apple_y)
      } else {
        tail_idx := (tail + 1) % max_body
      }
    }
  }
}

# ============================================================
#  3. ===== VIEW ================================================
#
#  raylib rendering. Reads body / apple / hud state; never
#  mutates. Layout constants and draw_* live only here.
# ============================================================

const cell_size : Int = 25

# Colors (0xRRGGBBAA).
const col_bg : Color = rgba(0x101820FF)

const col_grid_dark : Color = rgba(0x182030FF)

const col_snake : Color = rgba(0x6cfff5FF)  # mint cyan body

const col_head : Color = rgba(0xfdf9b9FF)  # pale yellow head

const col_apple : Color = rgba(0xff5050FF)

const col_text : Color = rgba(0xfdf9b9FF)

const col_dim : Color = rgba(0x808090FF)

fn draw_grid() : Unit / Ffi {
  var r := 0
  repeat(rows) {
    var c := 0
    repeat(cols) {
      # Subtle checkerboard so the playfield is legible.
      if (c + r) % 2 == 0 {
        raylib.draw_rectangle(
          c * cell_size,
          r * cell_size,
          cell_size,
          cell_size,
          col_grid_dark
        )
      }
      c := c + 1
    }

    r := r + 1
  }
}

fn draw_snake(
  body_x: Array[Int],
  body_y: Array[Int],
  head_idx: Int,
  tail_idx: Int
) : Unit / Ffi =
  draw_snake_loop(body_x, body_y, head_idx, tail_idx)

# Draw ring cells from `i` up to and including the head.
fn draw_snake_loop(
  body_x: Array[Int],
  body_y: Array[Int],
  head_idx: Int,
  i: Int
) : Unit / Ffi {
  let x = body_x[i]
  let y = body_y[i]
  let col = if i == head_idx { col_head } else { col_snake }
  raylib.draw_rectangle(
    x * cell_size + 1,
    y * cell_size + 1,
    cell_size - 2,
    cell_size - 2,
    col
  )
  if i != head_idx {
    draw_snake_loop(body_x, body_y, head_idx, (i + 1) % max_body)
  }
}

fn draw_apple(apple_x: Int, apple_y: Int) : Unit / Ffi {
  raylib.draw_rectangle(
    apple_x * cell_size + 4,
    apple_y * cell_size + 4,
    cell_size - 8,
    cell_size - 8,
    col_apple
  )
}

fn draw_hud(score: Int, game_over: Bool) : Unit / Ffi {
  raylib.draw_text("snake / kaikai + raylib", 10, 8, 14, col_text)
  raylib.draw_text(
    "arrows turn   R restart   ESC quit",
    10,
    580,
    14,
    col_dim
  )
  raylib.draw_text("score ", 660, 8, 14, col_dim)
  raylib.draw_text(int_to_string(score), 720, 8, 14, col_text)

  if game_over {
    raylib.draw_rectangle(220, 240, 360, 120, raylib.rgba(0x000000c8))
    raylib.draw_text("GAME OVER", 290, 270, 40, col_apple)
    raylib.draw_text("press R to play again", 280, 320, 20, col_text)
  }
}

# ============================================================
#  ===== ORCHESTRATOR ===========================================
# ============================================================

# Step rate: one game step every `step_every` frames.
const step_every : Int = 6  # 60 fps / 6 = 10 steps/sec

fn frame_loop(
  body_x: Array[Int],
  body_y: Array[Int],
  head_idx: Ref[Int],
  tail_idx: Ref[Int],
  direction: Ref[Dir],
  pending_dir: Ref[Dir],
  apple_x: Ref[Int],
  apple_y: Ref[Int],
  score: Ref[Int],
  game_over: Ref[Bool]
) : Unit / Ffi + Mutable {
  var frame := 0

  until { raylib.window_should_close() } {
    # ---- input ----
    if raylib.is_key_pressed(key_r) {
      reset(
        body_x,
        body_y,
        head_idx,
        tail_idx,
        direction,
        pending_dir,
        apple_x,
        apple_y,
        score,
        game_over
      )
    }

    # ---- STATE: tick the simulation ----
    if not (@game_over) {
      read_input(direction, pending_dir)
      if frame % step_every == 0 {
        step(
          body_x,
          body_y,
          head_idx,
          tail_idx,
          direction,
          pending_dir,
          apple_x,
          apple_y,
          score,
          game_over
        )
      }
    }

    # ---- VIEW: render ----
    raylib.begin_drawing()
    raylib.clear_background(col_bg)
    draw_grid()
    draw_apple(@apple_x, @apple_y)
    draw_snake(
      body_x,
      body_y,
      @head_idx,
      @tail_idx
    )
    draw_hud(@score, @game_over)
    raylib.end_drawing()

    frame := frame + 1
  }
}

fn main() : Unit / Ffi + Mutable {
  raylib.set_random_seed(42)

  let body_x = array_make(max_body, 0)
  let body_y = array_make(max_body, 0)
  let head_idx = Mutable.ref_make(0)
  let tail_idx = Mutable.ref_make(0)
  let direction = Mutable.ref_make(Right)
  let pending_dir = Mutable.ref_make(Right)
  let apple_x = Mutable.ref_make(8)
  let apple_y = Mutable.ref_make(12)
  let score = Mutable.ref_make(0)
  let game_over = Mutable.ref_make(false)

  raylib.init_window(800, 600, "Snake / kaikai + raylib")
  raylib.set_target_fps(60)

  reset(
    body_x,
    body_y,
    head_idx,
    tail_idx,
    direction,
    pending_dir,
    apple_x,
    apple_y,
    score,
    game_over
  )

  frame_loop(
    body_x,
    body_y,
    head_idx,
    tail_idx,
    direction,
    pending_dir,
    apple_x,
    apple_y,
    score,
    game_over
  )
  raylib.close_window()
}
