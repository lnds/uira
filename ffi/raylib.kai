# ----- fonts (Font crosses by value; no shim) -----
#
# LoadFontEx bakes a glyph atlas at `size`; the returned Font carries
# pointers into that atlas as opaque words. Pass it straight to
# DrawTextEx / MeasureTextEx. draw_text_ex takes I32 x/y and packs the
# Vector2 position itself, keeping the call site's pixel-integer feel.

extern "C"("LoadFontEx") pub fn load_font_ex(
  path: String,
  size: I32,
  codepoints: I64,
  count: I32
) : Font / Ffi

# Load a font with the default character set (codepoints = NULL, 0).
pub fn load_font(path: String, size: I32) : Font / Ffi =
  load_font_ex(path, size, 0, 0)

extern "C"("UnloadFont") pub fn unload_font(
  font: Font
) : Unit / Ffi

extern "C"("DrawTextEx") fn draw_text_ex_v(
  font: Font,
  s: String,
  pos: Vector2,
  size: F32,
  spacing: F32,
  color: Color
) : Unit / Ffi

pub fn draw_text_ex(
  font: Font,
  s: String,
  x: I32,
  y: I32,
  size: I32,
  spacing: F32,
  color: Color
) : Unit / Ffi =
  draw_text_ex_v(
    font,
    s,
    Vector2 { x: int_to_real(x), y: int_to_real(y) },
    int_to_real(size),
    spacing,
    color
  )

# ----- audio (Sound / Music cross by value; no shim) -----
#
# Sound and Music embed an AudioStream whose pointers ride across as
# opaque I64 words, same trick as Font. The one thing that stays in
# C is gen_tone: synthesising a tone means allocating a sample buffer
# and filling it, which the FFI can't express — see ffi/raylib_audio.c.

extern "C"("InitAudioDevice") pub fn init_audio_device() : Unit / Ffi

extern "C"("CloseAudioDevice") pub fn close_audio_device() : Unit / Ffi

extern "C"("IsAudioDeviceReady") pub fn audio_device_ready() : Bool / Ffi

extern "C"("SetMasterVolume") pub fn set_master_volume(
  volume: F32
) : Unit / Ffi

# Sounds (short SFX, fully loaded in memory).

extern "C"("LoadSound") pub fn load_sound(
  path: String
) : Sound / Ffi

# Synthesise a mono sine of `seconds` at `freq` Hz (amp 0..1) into a
# Sound — no file needed. The sample buffer can't be built in kaikai,
# so this stays in the C shim.
extern "C"("kai_raylib_gen_tone") pub fn gen_tone(
  freq: F32,
  seconds: F32,
  amp: F32
) : Sound / Ffi

extern "C"("PlaySound") pub fn play_sound(
  sound: Sound
) : Unit / Ffi

extern "C"("StopSound") pub fn stop_sound(
  sound: Sound
) : Unit / Ffi

extern "C"("IsSoundPlaying") pub fn sound_playing(
  sound: Sound
) : Bool / Ffi

extern "C"("SetSoundVolume") pub fn set_sound_volume(
  sound: Sound,
  volume: F32
) : Unit / Ffi

extern "C"("SetSoundPitch") pub fn set_sound_pitch(
  sound: Sound,
  pitch: F32
) : Unit / Ffi

extern "C"("UnloadSound") pub fn unload_sound(
  sound: Sound
) : Unit / Ffi

# Music (long tracks, streamed; call update_music every frame).

extern "C"("LoadMusicStream") pub fn load_music(
