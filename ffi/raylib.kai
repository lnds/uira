) : Unit / Ffi

extern "C"("UpdateMusicStream") pub fn update_music(
  music: Music
) : Unit / Ffi

extern "C"("StopMusicStream") pub fn stop_music(
  music: Music
) : Unit / Ffi

extern "C"("PauseMusicStream") pub fn pause_music(
