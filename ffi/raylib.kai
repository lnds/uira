) : Unit / Ffi

# ----- collisions (all by value) -----

#[doc("Returns true when two `Rect`s overlap (raylib `CheckCollisionRecs`).")]
extern "C"("CheckCollisionRecs") pub fn check_collision_recs(
  rec1: Rect,
  rec2: Rect
) : Bool / Ffi

#[doc("Returns true when two circles overlap (raylib `CheckCollisionCircles`).")]
extern "C"("CheckCollisionCircles") pub fn check_collision_circles(
  center1: Vector2,
  radius1: F32,
  center2: Vector2,
  radius2: F32
) : Bool / Ffi

#[doc("Returns true when a circle and a `Rect` overlap (raylib `CheckCollisionCircleRec`).")]
extern "C"("CheckCollisionCircleRec") pub fn check_collision_circle_rec(
  center: Vector2,
  radius: F32,
  rec: Rect
) : Bool / Ffi

#[doc("Returns true when `point` lies inside `rec` (raylib `CheckCollisionPointRec`).")]
extern "C"("CheckCollisionPointRec") pub fn check_collision_point_rec(
  point: Vector2,
  rec: Rect
) : Bool / Ffi

#[doc("Returns true when `point` lies inside the circle (raylib `CheckCollisionPointCircle`).")]
extern "C"("CheckCollisionPointCircle") pub fn check_collision_point_circle(
  point: Vector2,
  center: Vector2,
  radius: F32
) : Bool / Ffi

# ----- textures (Texture2D crosses by value; no shim) -----
#
# LoadTexture reads a PNG/JPG/… straight into VRAM and returns the
# Texture2D by value. draw_texture_pro is the sprite-sheet workhorse:
# `source` is the sub-rectangle to sample, `dest` where to put it (with
# scaling), `origin` the pivot for `rotation`.

#[doc("Loads an image file into GPU memory as a `Texture2D` (raylib `LoadTexture`).")]
extern "C"("LoadTexture") pub fn load_texture(
  path: String
) : Texture2D / Ffi

#[doc("Frees a texture's GPU memory (raylib `UnloadTexture`).")]
extern "C"("UnloadTexture") pub fn unload_texture(
  texture: Texture2D
) : Unit / Ffi

#[doc("Draws a texture at integer `x`, `y`, multiplied by `tint` (raylib `DrawTexture`).")]
extern "C"("DrawTexture") pub fn draw_texture(
  texture: Texture2D,
  x: I32,
  y: I32,
  tint: Color
) : Unit / Ffi

#[doc("Draws a texture at a `Vector2` position (raylib `DrawTextureV`).")]
extern "C"("DrawTextureV") pub fn draw_texture_v(
  texture: Texture2D,
  position: Vector2,
  tint: Color
) : Unit / Ffi

#[doc("Draws a texture with rotation (degrees) and uniform scale (raylib `DrawTextureEx`).")]
extern "C"("DrawTextureEx") pub fn draw_texture_ex(
  texture: Texture2D,
  position: Vector2,
  rotation: F32,
  scale: F32,
  tint: Color
) : Unit / Ffi

#[doc("Draws the `source` sub-rectangle of a texture at `position` (raylib `DrawTextureRec`).")]
extern "C"("DrawTextureRec") pub fn draw_texture_rec(
  texture: Texture2D,
  source: Rect,
  position: Vector2,
  tint: Color
) : Unit / Ffi

#[doc("Draws `source` of a texture scaled into `dest`, rotated about `origin` (raylib `DrawTexturePro`).")]
extern "C"("DrawTexturePro") pub fn draw_texture_pro(
  texture: Texture2D,
  source: Rect,
  dest: Rect,
  origin: Vector2,
  rotation: F32,
  tint: Color
) : Unit / Ffi

# ----- 2D camera (Camera2D crosses by value) -----
#
# Wrap world-space drawing between begin_mode_2d / end_mode_2d: every
# shape drawn inside is transformed by the camera (pan via target,
# zoom via zoom). The screen<->world helpers convert a point the same
# way, e.g. to turn a mouse position into a world coordinate.

#[doc("Starts drawing through a 2D camera; pair with `end_mode_2d` (raylib `BeginMode2D`).")]
extern "C"("BeginMode2D") pub fn begin_mode_2d(
  camera: Camera2D
) : Unit / Ffi

#[doc("Ends 2D camera mode started by `begin_mode_2d` (raylib `EndMode2D`).")]
extern "C"("EndMode2D") pub fn end_mode_2d() : Unit / Ffi

#[doc("Converts a world-space point to screen space through `camera` (raylib `GetWorldToScreen2D`).")]
extern "C"("GetWorldToScreen2D") pub fn get_world_to_screen_2d(
  position: Vector2,
  camera: Camera2D
) : Vector2 / Ffi

#[doc("Converts a screen-space point to world space through `camera` (raylib `GetScreenToWorld2D`).")]
extern "C"("GetScreenToWorld2D") pub fn get_screen_to_world_2d(
  position: Vector2,
  camera: Camera2D
) : Vector2 / Ffi

# ----- input: keyboard -----
#
# `is_key_pressed` fires once on the press edge; `is_key_down` is true
# every frame the key is held (use it for continuous movement). Key
# codes live in `ffi/keys.kai` (`import ffi.keys`).

#[doc("Returns true on the frame `key` goes down (raylib `IsKeyPressed`).")]
extern "C"("IsKeyPressed") pub fn is_key_pressed(
  key: I32
) : Bool / Ffi

#[doc("Returns true every frame `key` is held (raylib `IsKeyDown`).")]
extern "C"("IsKeyDown") pub fn is_key_down(
  key: I32
) : Bool / Ffi

#[doc("Returns true on the frame `key` is released (raylib `IsKeyReleased`).")]
extern "C"("IsKeyReleased") pub fn is_key_released(
  key: I32
) : Bool / Ffi

#[doc("Returns true while `key` is not held (raylib `IsKeyUp`).")]
extern "C"("IsKeyUp") pub fn is_key_up(
  key: I32
) : Bool / Ffi

#[doc("Pops the next queued key code, or 0 when the queue is empty (raylib `GetKeyPressed`).")]
extern "C"("GetKeyPressed") pub fn get_key_pressed() : I32 / Ffi

#[doc("Pops the next queued Unicode character, or 0 when the queue is empty (raylib `GetCharPressed`).")]
extern "C"("GetCharPressed") pub fn get_char_pressed() : I32 / Ffi

# ----- input: mouse -----

#[doc("Returns true on the frame `button` goes down (raylib `IsMouseButtonPressed`).")]
extern "C"("IsMouseButtonPressed") pub fn is_mouse_button_pressed(
  button: I32
) : Bool / Ffi

#[doc("Returns true every frame `button` is held (raylib `IsMouseButtonDown`).")]
extern "C"("IsMouseButtonDown") pub fn is_mouse_button_down(
  button: I32
) : Bool / Ffi

#[doc("Returns true on the frame `button` is released (raylib `IsMouseButtonReleased`).")]
extern "C"("IsMouseButtonReleased") pub fn is_mouse_button_released(
  button: I32
) : Bool / Ffi

#[doc("Returns the mouse X position in pixels (raylib `GetMouseX`).")]
extern "C"("GetMouseX") pub fn get_mouse_x() : I32 / Ffi

#[doc("Returns the mouse Y position in pixels (raylib `GetMouseY`).")]
extern "C"("GetMouseY") pub fn get_mouse_y() : I32 / Ffi

#[doc("Returns the mouse position as a `Vector2` (raylib `GetMousePosition`).")]
extern "C"("GetMousePosition") pub fn get_mouse_position() : Vector2 / Ffi

#[doc("Returns how far the mouse moved since the previous frame (raylib `GetMouseDelta`).")]
extern "C"("GetMouseDelta") pub fn get_mouse_delta() : Vector2 / Ffi

#[doc("Moves the mouse cursor to `x`, `y` (raylib `SetMousePosition`).")]
extern "C"("SetMousePosition") pub fn set_mouse_position(
  x: I32,
  y: I32
) : Unit / Ffi

#[doc("Returns the mouse wheel movement for this frame (raylib `GetMouseWheelMove`).")]
extern "C"("GetMouseWheelMove") pub fn get_mouse_wheel_move() : F32 / Ffi

#[doc("Sets the cursor shape to a `keys.mouse_cursor_*` code (raylib `SetMouseCursor`).")]
extern "C"("SetMouseCursor") pub fn set_mouse_cursor(
  cursor: I32
) : Unit / Ffi

# ----- input: gamepad -----

#[doc("Returns true when gamepad number `gamepad` is connected (raylib `IsGamepadAvailable`).")]
extern "C"("IsGamepadAvailable") pub fn is_gamepad_available(
  gamepad: I32
) : Bool / Ffi

#[doc("Returns true on the frame a gamepad button goes down (raylib `IsGamepadButtonPressed`).")]
extern "C"("IsGamepadButtonPressed") pub fn is_gamepad_button_pressed(
  gamepad: I32,
  button: I32
) : Bool / Ffi

#[doc("Returns true every frame a gamepad button is held (raylib `IsGamepadButtonDown`).")]
extern "C"("IsGamepadButtonDown") pub fn is_gamepad_button_down(
  gamepad: I32,
  button: I32
) : Bool / Ffi

#[doc("Returns the current value of a gamepad axis (raylib `GetGamepadAxisMovement`).")]
extern "C"("GetGamepadAxisMovement") pub fn get_gamepad_axis_movement(
  gamepad: I32,
  axis: I32
) : F32 / Ffi

# ----- random -----

#[doc("Seeds raylib's random generator (raylib `SetRandomSeed`).")]
extern "C"("SetRandomSeed") pub fn set_random_seed(
  s: I32
) : Unit / Ffi

#[doc("Returns a random integer between `min` and `max`, both inclusive (raylib `GetRandomValue`).")]
extern "C"("GetRandomValue") pub fn get_random_value(
  min: I32,
  max: I32
) : I32 / Ffi

# ----- fonts (Font crosses by value; no shim) -----
#
# LoadFontEx bakes a glyph atlas at `size`; the returned Font carries
# pointers into that atlas as opaque words. Pass it straight to
# DrawTextEx / MeasureTextEx. draw_text_ex takes I32 x/y and packs the
# Vector2 position itself, keeping the call site's pixel-integer feel.

#[doc("Loads a font file baked at `size`; `codepoints` is an opaque C pointer, 0 with `count` 0 for the default set (raylib `LoadFontEx`).")]
extern "C"("LoadFontEx") pub fn load_font_ex(
  path: String,
  size: I32,
  codepoints: I64,
  count: I32
) : Font / Ffi

#[doc("Loads a font file baked at `size` with the default character set.")]
pub fn load_font(path: String, size: I32) : Font / Ffi =
  load_font_ex(path, size, 0, 0)

#[doc("Frees a font's atlas and glyph data (raylib `UnloadFont`).")]
extern "C"("UnloadFont") pub fn unload_font(
  font: Font
) : Unit / Ffi

extern "C"("DrawTextEx") fn draw_text_ex_v(
  font: Font,
  s: String,
  pos: Vector2,
  size: F32,
  spacing: F32,
  color: Color
) : Unit / Ffi

#[doc("Draws `s` with a custom `font` at integer `x`, `y`, `size` pixels tall, with extra `spacing` between glyphs (wraps raylib `DrawTextEx`).")]
pub fn draw_text_ex(
  font: Font,
  s: String,
  x: I32,
  y: I32,
  size: I32,
  spacing: F32,
  color: Color
) : Unit / Ffi =
  draw_text_ex_v(
    font,
    s,
    Vector2 { x: int_to_real(x), y: int_to_real(y) },
    int_to_real(size),
    spacing,
    color
  )

# ----- audio (Sound / Music cross by value; no shim) -----
#
# Sound and Music embed an AudioStream whose pointers ride across as
# opaque I64 words, same trick as Font. The one thing that stays in
# C is gen_tone: synthesising a tone means allocating a sample buffer
# and filling it, which the FFI can't express — see ffi/raylib_audio.c.

#[doc("Initialises the audio device and context (raylib `InitAudioDevice`).")]
extern "C"("InitAudioDevice") pub fn init_audio_device() : Unit / Ffi

#[doc("Closes the audio device and context (raylib `CloseAudioDevice`).")]
extern "C"("CloseAudioDevice") pub fn close_audio_device() : Unit / Ffi

#[doc("Returns true once the audio device is initialised (raylib `IsAudioDeviceReady`).")]
extern "C"("IsAudioDeviceReady") pub fn audio_device_ready() : Bool / Ffi

#[doc("Sets the master volume, 1.0 being full (raylib `SetMasterVolume`).")]
extern "C"("SetMasterVolume") pub fn set_master_volume(
  volume: F32
) : Unit / Ffi

# Sounds (short SFX, fully loaded in memory).

#[doc("Loads a sound file fully into memory (raylib `LoadSound`).")]
extern "C"("LoadSound") pub fn load_sound(
  path: String
) : Sound / Ffi

# The sample buffer can't be built in kaikai, so this binds the C shim
# in ffi/raylib_audio.c rather than raylib directly.
#[doc("Synthesises a mono sine `Sound` of `seconds` at `freq` Hz with amplitude `amp` (0..1), no file needed.")]
extern "C"("kai_raylib_gen_tone") pub fn gen_tone(
  freq: F32,
  seconds: F32,
  amp: F32
) : Sound / Ffi

#[doc("Plays a sound (raylib `PlaySound`).")]
extern "C"("PlaySound") pub fn play_sound(
  sound: Sound
) : Unit / Ffi

#[doc("Stops a playing sound (raylib `StopSound`).")]
extern "C"("StopSound") pub fn stop_sound(
  sound: Sound
) : Unit / Ffi

#[doc("Returns true while a sound is playing (raylib `IsSoundPlaying`).")]
extern "C"("IsSoundPlaying") pub fn sound_playing(
  sound: Sound
) : Bool / Ffi

#[doc("Sets a sound's volume, 1.0 being full (raylib `SetSoundVolume`).")]
extern "C"("SetSoundVolume") pub fn set_sound_volume(
  sound: Sound,
  volume: F32
) : Unit / Ffi

#[doc("Sets a sound's pitch, 1.0 being the original (raylib `SetSoundPitch`).")]
extern "C"("SetSoundPitch") pub fn set_sound_pitch(
  sound: Sound,
  pitch: F32
) : Unit / Ffi

#[doc("Frees a sound's sample data (raylib `UnloadSound`).")]
extern "C"("UnloadSound") pub fn unload_sound(
  sound: Sound
) : Unit / Ffi

# Music (long tracks, streamed; call update_music every frame).

#[doc("Opens a music file for streaming (raylib `LoadMusicStream`).")]
extern "C"("LoadMusicStream") pub fn load_music(
  path: String
) : Music / Ffi

#[doc("Starts playing a music stream (raylib `PlayMusicStream`).")]
extern "C"("PlayMusicStream") pub fn play_music(
  music: Music
) : Unit / Ffi

#[doc("Refills a music stream's buffers; call it every frame while playing (raylib `UpdateMusicStream`).")]
extern "C"("UpdateMusicStream") pub fn update_music(
  music: Music
) : Unit / Ffi

#[doc("Stops a music stream (raylib `StopMusicStream`).")]
extern "C"("StopMusicStream") pub fn stop_music(
  music: Music
) : Unit / Ffi

#[doc("Pauses a music stream (raylib `PauseMusicStream`).")]
extern "C"("PauseMusicStream") pub fn pause_music(
  music: Music
) : Unit / Ffi

#[doc("Resumes a paused music stream (raylib `ResumeMusicStream`).")]
extern "C"("ResumeMusicStream") pub fn resume_music(
  music: Music
) : Unit / Ffi

#[doc("Returns true while a music stream is playing (raylib `IsMusicStreamPlaying`).")]
extern "C"("IsMusicStreamPlaying") pub fn music_playing(
  music: Music
) : Bool / Ffi

#[doc("Sets a music stream's volume, 1.0 being full (raylib `SetMusicVolume`).")]
extern "C"("SetMusicVolume") pub fn set_music_volume(
  music: Music,
  volume: F32
) : Unit / Ffi

#[doc("Sets a music stream's pitch, 1.0 being the original (raylib `SetMusicPitch`).")]
extern "C"("SetMusicPitch") pub fn set_music_pitch(
  music: Music,
  pitch: F32
) : Unit / Ffi

#[doc("Seeks a music stream to `position` seconds (raylib `SeekMusicStream`).")]
extern "C"("SeekMusicStream") pub fn seek_music(
  music: Music,
  position: F32
) : Unit / Ffi

#[doc("Closes a music stream (raylib `UnloadMusicStream`).")]
extern "C"("UnloadMusicStream") pub fn unload_music(
  music: Music
) : Unit / Ffi

#[doc("Returns `music` set to loop, or not, when it reaches the end; raylib reads the flag from the struct on each update.")]
pub fn set_music_looping(music: Music, on: Bool) : Music =
  Music { ...music, looping: if on { 1 } else { 0 } }

# ----- colour helpers (Color by value) -----
#
# rgba() packs a hex literal; these transform Colors raylib's way.
# color_from_hsv is handy for spreading hues; fade/color_alpha adjust
# transparency; color_lerp blends two Colors.

#[doc("Returns `color` with its alpha set to `alpha` (0..1) (raylib `Fade`).")]
extern "C"("Fade") pub fn fade(
  color: Color,
  alpha: F32
) : Color / Ffi

#[doc("Returns `color` with its alpha set to `alpha` (0..1) (raylib `ColorAlpha`).")]
extern "C"("ColorAlpha") pub fn color_alpha(
  color: Color,
  alpha: F32
) : Color / Ffi

#[doc("Builds a `Color` from hue (degrees 0..360) and saturation/value (0..1) (raylib `ColorFromHSV`).")]
extern "C"("ColorFromHSV") pub fn color_from_hsv(
  hue: F32,
  saturation: F32,
  value: F32
) : Color / Ffi

#[doc("Multiplies `color` by `tint` channel-wise (raylib `ColorTint`).")]
extern "C"("ColorTint") pub fn color_tint(
  color: Color,
  tint: Color
) : Color / Ffi

#[doc("Brightens or darkens `color` by `factor` in -1..1 (raylib `ColorBrightness`).")]
extern "C"("ColorBrightness") pub fn color_brightness(
  color: Color,
  factor: F32
) : Color / Ffi

#[doc("Blends `a` toward `b` by `factor` in 0..1 (raylib `ColorLerp`).")]
extern "C"("ColorLerp") pub fn color_lerp(
  a: Color,
  b: Color,
  factor: F32
) : Color / Ffi

#[doc("Unpacks a 0xRRGGBBAA integer into a `Color`; the inverse of `color_to_int` (raylib `GetColor`).")]
extern "C"("GetColor") pub fn get_color(
  hex: I32
) : Color / Ffi

#[doc("Packs a `Color` into a 0xRRGGBBAA integer; the inverse of `get_color` (raylib `ColorToInt`).")]
extern "C"("ColorToInt") pub fn color_to_int(
  color: Color
) : I32 / Ffi

# ----- text measurement -----
#
# measure_text is the default-font width in pixels; measure_text_ex
# takes a custom Font (by value, like draw_text_ex) and returns the
# {width, height} extent as a Vector2.

#[doc("Returns the width in pixels of `s` in the default font at `size` (raylib `MeasureText`).")]
extern "C"("MeasureText") pub fn measure_text(
  s: String,
  size: I32
) : I32 / Ffi

#[doc("Returns the width and height of `s` in `font` as a `Vector2` (raylib `MeasureTextEx`).")]
extern "C"("MeasureTextEx") pub fn measure_text_ex(
  font: Font,
  s: String,
  size: F32,
  spacing: F32
) : Vector2 / Ffi

#[doc("Sets the line spacing used when drawing multi-line text (raylib `SetTextLineSpacing`).")]
extern "C"("SetTextLineSpacing") pub fn set_text_line_spacing(
  spacing: I32
) : Unit / Ffi

# ----- timing -----
#
# get_frame_time is the seconds elapsed since the last frame — the
# delta to scale movement by so it's frame-rate independent.

#[doc("Returns the seconds the last frame took, the delta for frame-rate independent motion (raylib `GetFrameTime`).")]
extern "C"("GetFrameTime") pub fn get_frame_time() : F32 / Ffi

#[doc("Blocks the program for `seconds` (raylib `WaitTime`).")]
extern "C"("WaitTime") pub fn wait_time(
  seconds: Real
) : Unit / Ffi

# ----- math (libm direct) -----

#[doc("Sine of `x` in radians (libm `sin`).")]
extern "C" pub fn sin(x: Real) : Real / Ffi

#[doc("Cosine of `x` in radians (libm `cos`).")]
extern "C" pub fn cos(x: Real) : Real / Ffi

#[doc("Tangent of `x` in radians (libm `tan`).")]
extern "C" pub fn tan(x: Real) : Real / Ffi

#[doc("Arc sine of `x`, in radians (libm `asin`).")]
extern "C" pub fn asin(x: Real) : Real / Ffi

#[doc("Arc cosine of `x`, in radians (libm `acos`).")]
extern "C" pub fn acos(x: Real) : Real / Ffi

#[doc("Arc tangent of `x`, in radians (libm `atan`).")]
extern "C" pub fn atan(x: Real) : Real / Ffi

#[doc("Angle in radians of the point (`x`, `y`), using both signs to pick the quadrant (libm `atan2`).")]
extern "C" pub fn atan2(y: Real, x: Real) : Real / Ffi

#[doc("Square root of `x` (libm `sqrt`).")]
extern "C" pub fn sqrt(x: Real) : Real / Ffi

#[doc("`x` raised to the power `y` (libm `pow`).")]
extern "C" pub fn pow(x: Real, y: Real) : Real / Ffi

#[doc("e raised to the power `x` (libm `exp`).")]
extern "C" pub fn exp(x: Real) : Real / Ffi

#[doc("Natural logarithm of `x` (libm `log`).")]
extern "C" pub fn log(x: Real) : Real / Ffi

#[doc("Largest integral value not greater than `x` (libm `floor`).")]
extern "C" pub fn floor(x: Real) : Real / Ffi

#[doc("Smallest integral value not less than `x` (libm `ceil`).")]
extern "C" pub fn ceil(x: Real) : Real / Ffi

#[doc("`x` rounded to the nearest integral value, halfway cases away from zero (libm `round`).")]
extern "C" pub fn round(x: Real) : Real / Ffi

#[doc("Absolute value of `x` (libm `fabs`).")]
extern "C" pub fn fabs(x: Real) : Real / Ffi

#[doc("Floating-point remainder of `x / y`, with the sign of `x` (libm `fmod`).")]
extern "C" pub fn fmod(x: Real, y: Real) : Real / Ffi

#[doc("Length of the vector (`x`, `y`), sqrt(x² + y²) without overflow (libm `hypot`).")]
extern "C" pub fn hypot(x: Real, y: Real) : Real / Ffi
# raymath's scalar helpers (Clamp/Lerp/Remap/Wrap) are intentionally
# NOT bound: they're one-liners in kaikai, and binding them under
# common names like `clamp` collides with a caller's own `clamp` on
# the native backend. Write them inline instead.
