# ----- input: keyboard -----
#
# `is_key_pressed` fires once on the press edge; `is_key_down` is true
# every frame the key is held (use it for continuous movement). Key
# codes live in `ffi/keys.kai` (`import ffi.keys`).

extern "C"("IsKeyPressed")
pub fn is_key_pressed(key: I32) : Bool / Ffi

extern "C"("IsKeyDown")
pub fn is_key_down(key: I32) : Bool / Ffi

extern "C"("IsKeyReleased")
pub fn is_key_released(key: I32) : Bool / Ffi

extern "C"("IsKeyUp")
pub fn is_key_up(key: I32) : Bool / Ffi

# Pop the next queued keycode / unicode char (0 when the queue drains).
extern "C"("GetKeyPressed")
pub fn get_key_pressed() : I32 / Ffi

extern "C"("GetCharPressed")
pub fn get_char_pressed() : I32 / Ffi

