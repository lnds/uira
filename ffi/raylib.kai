# raylib FFI bindings (FFI v2).
#
# Color/Vector2 cross by value as `extern "C" type` records whose
# fields are ABI-identical to raylib's own structs, so the bindings
# link straight to raylib (DrawCircleV, ClearBackground, …) with no
# C shim. The trick: the emitted out.c must NOT `-include raylib.h`,
# or its generated `Color`/`Vector2` typedefs collide with raylib's.
# kaikai's structs and raylib's share layout; the linker bridges them.
#
# Font, Sound and Music hold pointers into raylib's internals, but
# still cross by value: those pointer fields ride along as opaque I64
# words that kaikai copies without dereferencing. The one thing that
# can't cross is a synthesised tone's sample buffer, so gen_tone stays
# in ffi/raylib_audio.c.
#
# Math (sin/cos/atan2/sqrt) links directly to libm under bare names.

# ----- boundary types -----

extern "C" pub type Color = { r: U8, g: U8, b: U8, a: U8 }

extern "C" pub type Vector2 = { x: F32, y: F32 }

extern "C" pub type Rect = { x: F32, y: F32, w: F32, h: F32 }

# Texture2D is all scalars (an OpenGL id + dimensions), so it crosses
# by value with no shim.
extern "C" pub type Texture2D = { id: U32, width: I32, height: I32, mipmaps: I32, format: I32 }

# Camera2D is all scalars (two Vector2 + two F32), so it crosses by
# value. `offset` is the screen-space anchor, `target` the world point
# under it; `zoom` scales around the target (1.0 = no zoom).
extern "C" pub type Camera2D = { offset: Vector2, target: Vector2, rotation: F32, zoom: F32 }

# Font, Sound and Music embed pointers into raylib's internals
# (glyph tables, audio buffers). They still cross by value: the
# pointer fields ride along as opaque I64 words — kaikai copies the
# bits without dereferencing them, and raylib gets them back intact.
# The `Real` sample buffer behind a synthesised tone is the one thing
# kaikai can't build, so gen_tone stays in ffi/raylib_audio.c.
extern "C" pub type Font = { base_size: I32, glyph_count: I32, glyph_padding: I32, texture: Texture2D, recs: I64, glyphs: I64 }

extern "C" pub type AudioStream = { buffer: I64, processor: I64, sample_rate: U32, sample_size: U32, channels: U32 }

extern "C" pub type Sound = { stream: AudioStream, frame_count: U32 }

# `looping` is a C `bool` (1 byte) but we widen it to I32 so the
# field layout matches raylib's — the compiler pads it to 4 bytes
# either way, and a fixed-width word keeps the by-value copy exact.
extern "C" pub type Music = { stream: AudioStream, frame_count: U32, looping: I32, ctx_type: I32, ctx_data: I64 }

#[doc("Packs a 0xRRGGBBAA integer literal into a `Color`, so call sites can keep writing colors as hex.")]
pub fn rgba(p: Int) : Color =
  Color {
    r: p / 16777216 % 256,
    g: p / 65536 % 256,
    b: p / 256 % 256,
    a: p % 256
  }

# ----- window / lifecycle -----

#[doc("Opens a `w`×`h` window titled `title` and initialises the OpenGL context (raylib `InitWindow`).")]
extern "C"("InitWindow") pub fn init_window(
  w: I32,
  h: I32,
  title: String
) : Unit / Ffi

#[doc("Closes the window and unloads the OpenGL context (raylib `CloseWindow`).")]
extern "C"("CloseWindow") pub fn close_window() : Unit / Ffi

#[doc("Returns true once the user asks to close the window (close button or Escape) (raylib `WindowShouldClose`).")]
extern "C"("WindowShouldClose") pub fn window_should_close() : Bool / Ffi

#[doc("Sets the target frame rate that `end_drawing` paces to (raylib `SetTargetFPS`).")]
extern "C"("SetTargetFPS") pub fn set_target_fps(
  fps: I32
) : Unit / Ffi

#[doc("Returns the current frames per second (raylib `GetFPS`).")]
extern "C"("GetFPS") pub fn get_fps() : I32 / Ffi

#[doc("Returns the seconds elapsed since `init_window` (raylib `GetTime`).")]
extern "C"("GetTime") pub fn get_time() : Real / Ffi

# ----- frame -----

#[doc("Starts a frame; pair with `end_drawing` (raylib `BeginDrawing`).")]
extern "C"("BeginDrawing") pub fn begin_drawing() : Unit / Ffi

#[doc("Ends the frame, swaps buffers and polls input events (raylib `EndDrawing`).")]
extern "C"("EndDrawing") pub fn end_drawing() : Unit / Ffi

#[doc("Fills the whole framebuffer with `color` (raylib `ClearBackground`).")]
extern "C"("ClearBackground") pub fn clear_background(
  color: Color
) : Unit / Ffi

# ----- shapes / text -----

#[doc("Draws a filled rectangle at integer `x`, `y` with size `w`×`h` (raylib `DrawRectangle`).")]
extern "C"("DrawRectangle") pub fn draw_rectangle(
  x: I32,
  y: I32,
  w: I32,
  h: I32,
  color: Color
) : Unit / Ffi

#[doc("Draws a single pixel at `x`, `y` (raylib `DrawPixel`).")]
extern "C"("DrawPixel") pub fn draw_pixel(
  x: I32,
  y: I32,
  color: Color
) : Unit / Ffi

#[doc("Draws `s` with the default font at `x`, `y`, `size` pixels tall (raylib `DrawText`).")]
extern "C"("DrawText") pub fn draw_text(
  s: String,
  x: I32,
  y: I32,
  size: I32,
  color: Color
) : Unit / Ffi

#[doc("Draws a filled triangle; vertices go in counter-clockwise order (raylib `DrawTriangle`).")]
extern "C"("DrawTriangle") pub fn draw_triangle_v(
  v1: Vector2,
  v2: Vector2,
  v3: Vector2,
  color: Color
) : Unit / Ffi

#[doc("Draws a 1px line between two integer points (raylib `DrawLine`).")]
extern "C"("DrawLine") pub fn draw_line(
  x1: I32,
  y1: I32,
  x2: I32,
  y2: I32,
  color: Color
) : Unit / Ffi

#[doc("Draws a filled circle centred at `x`, `y` with radius `r` (raylib `DrawCircle`).")]
extern "C"("DrawCircle") pub fn draw_circle(
  x: I32,
  y: I32,
  r: F32,
  color: Color
) : Unit / Ffi

# ----- shapes: rectangles (Vector2 / Rect by value) -----

#[doc("Draws a filled rectangle from a `Vector2` position and size (raylib `DrawRectangleV`).")]
extern "C"("DrawRectangleV") pub fn draw_rectangle_v(
  position: Vector2,
  size: Vector2,
  color: Color
) : Unit / Ffi

#[doc("Draws a filled `Rect` (raylib `DrawRectangleRec`).")]
extern "C"("DrawRectangleRec") pub fn draw_rectangle_rec(
  rec: Rect,
  color: Color
) : Unit / Ffi

#[doc("Draws a rotated rectangle; `origin` is the pivot relative to `rec`'s top-left, `rotation` in degrees (raylib `DrawRectanglePro`).")]
extern "C"("DrawRectanglePro") pub fn draw_rectangle_pro(
  rec: Rect,
  origin: Vector2,
  rotation: F32,
  color: Color
) : Unit / Ffi

#[doc("Draws a rectangle outline at integer `x`, `y` with size `w`×`h` (raylib `DrawRectangleLines`).")]
extern "C"("DrawRectangleLines") pub fn draw_rectangle_lines(
  x: I32,
  y: I32,
  w: I32,
  h: I32,
  color: Color
) : Unit / Ffi

#[doc("Draws a `Rect` outline `line_thick` pixels wide (raylib `DrawRectangleLinesEx`).")]
extern "C"("DrawRectangleLinesEx") pub fn draw_rectangle_lines_ex(
  rec: Rect,
  line_thick: F32,
  color: Color
) : Unit / Ffi

#[doc("Draws a filled `Rect` with rounded corners; `roundness` runs 0..1 (raylib `DrawRectangleRounded`).")]
extern "C"("DrawRectangleRounded") pub fn draw_rectangle_rounded(
  rec: Rect,
  roundness: F32,
  segments: I32,
  color: Color
) : Unit / Ffi

#[doc("Draws a rectangle with a vertical gradient from `top` to `bottom` (raylib `DrawRectangleGradientV`).")]
extern "C"("DrawRectangleGradientV") pub fn draw_rectangle_gradient_v(
  x: I32,
  y: I32,
  w: I32,
  h: I32,
  top: Color,
  bottom: Color
) : Unit / Ffi

#[doc("Draws a rectangle with a horizontal gradient from `left` to `right` (raylib `DrawRectangleGradientH`).")]
extern "C"("DrawRectangleGradientH") pub fn draw_rectangle_gradient_h(
  x: I32,
  y: I32,
  w: I32,
  h: I32,
  left: Color,
  right: Color
) : Unit / Ffi

# ----- shapes: circles / ellipses -----

#[doc("Draws a filled circle at a `Vector2` centre (raylib `DrawCircleV`).")]
extern "C"("DrawCircleV") pub fn draw_circle_v(
  center: Vector2,
  radius: F32,
  color: Color
) : Unit / Ffi

#[doc("Draws a circle outline centred at `x`, `y` (raylib `DrawCircleLines`).")]
extern "C"("DrawCircleLines") pub fn draw_circle_lines(
  x: I32,
  y: I32,
  radius: F32,
  color: Color
) : Unit / Ffi

#[doc("Draws a filled circle with a radial gradient from `inner` to `outer` (raylib `DrawCircleGradient`).")]
extern "C"("DrawCircleGradient") pub fn draw_circle_gradient(
  x: I32,
  y: I32,
  radius: F32,
  inner: Color,
  outer: Color
) : Unit / Ffi

#[doc("Draws a filled circle sector between two angles in degrees (raylib `DrawCircleSector`).")]
extern "C"("DrawCircleSector") pub fn draw_circle_sector(
  center: Vector2,
  radius: F32,
  start_angle: F32,
  end_angle: F32,
  segments: I32,
  color: Color
) : Unit / Ffi

#[doc("Draws a filled ellipse centred at `x`, `y` with radii `radius_h`, `radius_v` (raylib `DrawEllipse`).")]
extern "C"("DrawEllipse") pub fn draw_ellipse(
  x: I32,
  y: I32,
  radius_h: F32,
  radius_v: F32,
  color: Color
) : Unit / Ffi

#[doc("Draws a filled ring (annulus) sector between two angles in degrees (raylib `DrawRing`).")]
extern "C"("DrawRing") pub fn draw_ring(
  center: Vector2,
  inner_radius: F32,
  outer_radius: F32,
  start_angle: F32,
  end_angle: F32,
  segments: I32,
  color: Color
) : Unit / Ffi

# ----- shapes: lines / pixels / polygons -----

#[doc("Draws a single pixel at a `Vector2` position (raylib `DrawPixelV`).")]
extern "C"("DrawPixelV") pub fn draw_pixel_v(
  position: Vector2,
  color: Color
) : Unit / Ffi

#[doc("Draws a 1px line between two `Vector2` points (raylib `DrawLineV`).")]
extern "C"("DrawLineV") pub fn draw_line_v(
  start: Vector2,
  end: Vector2,
  color: Color
) : Unit / Ffi

#[doc("Draws a line `thick` pixels wide; `draw_line` is the 1px integer variant (raylib `DrawLineEx`).")]
extern "C"("DrawLineEx") pub fn draw_line_ex(
  start: Vector2,
  end: Vector2,
  thick: F32,
  color: Color
) : Unit / Ffi

#[doc("Draws a triangle outline (raylib `DrawTriangleLines`).")]
extern "C"("DrawTriangleLines") pub fn draw_triangle_lines(
  v1: Vector2,
  v2: Vector2,
  v3: Vector2,
  color: Color
) : Unit / Ffi

#[doc("Draws a filled regular `sides`-gon centred at `center`, `radius` to each vertex (raylib `DrawPoly`).")]
extern "C"("DrawPoly") pub fn draw_poly(
  center: Vector2,
  sides: I32,
  radius: F32,
  rotation: F32,
  color: Color
) : Unit / Ffi

#[doc("Draws a regular `sides`-gon outline centred at `center` (raylib `DrawPolyLines`).")]
extern "C"("DrawPolyLines") pub fn draw_poly_lines(
  center: Vector2,
  sides: I32,
  radius: F32,
