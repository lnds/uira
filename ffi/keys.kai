# ----- mouse (MouseButton) -----

#[doc("Mouse button code for the left button.")]
pub const mouse_button_left : Int = 0

#[doc("Mouse button code for the right button.")]
pub const mouse_button_right : Int = 1

#[doc("Mouse button code for the middle (wheel) button.")]
pub const mouse_button_middle : Int = 2

#[doc("Mouse button code for the side (advanced mice) button.")]
pub const mouse_button_side : Int = 3

#[doc("Mouse button code for the extra (advanced mice) button.")]
pub const mouse_button_extra : Int = 4

#[doc("Mouse button code for the forward (advanced mice) button.")]
pub const mouse_button_forward : Int = 5

#[doc("Mouse button code for the back (advanced mice) button.")]
pub const mouse_button_back : Int = 6

# ----- mouse cursor (MouseCursor) — arg to set_mouse_cursor -----

#[doc("Cursor code for the default cursor; pass to `set_mouse_cursor`.")]
pub const mouse_cursor_default : Int = 0

#[doc("Cursor code for the arrow cursor; pass to `set_mouse_cursor`.")]
pub const mouse_cursor_arrow : Int = 1

#[doc("Cursor code for the text I-beam cursor; pass to `set_mouse_cursor`.")]
pub const mouse_cursor_ibeam : Int = 2

#[doc("Cursor code for the crosshair cursor; pass to `set_mouse_cursor`.")]
pub const mouse_cursor_crosshair : Int = 3

#[doc("Cursor code for the pointing-hand cursor; pass to `set_mouse_cursor`.")]
pub const mouse_cursor_pointing_hand : Int = 4

#[doc("Cursor code for the horizontal (east-west) resize cursor; pass to `set_mouse_cursor`.")]
pub const mouse_cursor_resize_ew : Int = 5

#[doc("Cursor code for the vertical (north-south) resize cursor; pass to `set_mouse_cursor`.")]
pub const mouse_cursor_resize_ns : Int = 6

#[doc("Cursor code for the operation-not-allowed cursor; pass to `set_mouse_cursor`.")]
pub const mouse_cursor_not_allowed : Int = 10

# ----- gamepad -----

#[doc("Gamepad button code for the left-face up button (D-pad up).")]
