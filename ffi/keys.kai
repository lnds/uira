#[doc("Gamepad button code for the right-face down button (Xbox A, PS Cross).")]
pub const gamepad_button_right_face_down : Int = 7

#[doc("Gamepad button code for the right-face left button (Xbox X, PS Square).")]
pub const gamepad_button_right_face_left : Int = 8

#[doc("Gamepad axis code for the left stick's X axis.")]
