#[doc("Gamepad axis code for the left stick's Y axis.")]
pub const gamepad_axis_left_y : Int = 1

#[doc("Gamepad axis code for the right stick's X axis.")]
pub const gamepad_axis_right_x : Int = 2

#[doc("Gamepad axis code for the right stick's Y axis.")]
pub const gamepad_axis_right_y : Int = 3
