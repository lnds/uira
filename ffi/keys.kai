# raylib input constants — keycodes, mouse buttons/cursors, gamepad.
#
# Values are raylib's own enums (KeyboardKey, MouseButton, …), copied
# as plain Ints so call sites read `keys.key_left` instead of `263`.
# Pass them to raylib.is_key_down / is_mouse_button_pressed / etc.

# ----- keyboard (KeyboardKey) -----

# Navigation / editing.
#[doc("Key code for the Space key.")]
pub const key_space : Int = 32

#[doc("Key code for the Escape key.")]
pub const key_escape : Int = 256

#[doc("Key code for the Enter key.")]
pub const key_enter : Int = 257

#[doc("Key code for the Tab key.")]
pub const key_tab : Int = 258

#[doc("Key code for the Backspace key.")]
pub const key_backspace : Int = 259

#[doc("Key code for the Insert key.")]
pub const key_insert : Int = 260

#[doc("Key code for the Delete key.")]
pub const key_delete : Int = 261

#[doc("Key code for the Right arrow key.")]
pub const key_right : Int = 262

#[doc("Key code for the Left arrow key.")]
pub const key_left : Int = 263

#[doc("Key code for the Down arrow key.")]
pub const key_down : Int = 264

#[doc("Key code for the Up arrow key.")]
pub const key_up : Int = 265

#[doc("Key code for the Page Up key.")]
pub const key_page_up : Int = 266

#[doc("Key code for the Page Down key.")]
pub const key_page_down : Int = 267

#[doc("Key code for the Home key.")]
pub const key_home : Int = 268

#[doc("Key code for the End key.")]
pub const key_end : Int = 269

