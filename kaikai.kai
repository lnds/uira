# Kaikai rapanui — kaikai + raylib showcase
#
# Simulates the Rapa Nui string game kaikai (figures made with a
# closed loop of cord held between the fingers). Each "figure" is a
# closed polygon of N=12 vertices in local coordinates; the
# animation linearly interpolates vertex by vertex between the
# current figure and the next one with smoothstep easing, and
# applies a slow global rotation to suggest hands turning the cord.
#
# Three layers:
#
#   1. ===== MODEL =====   library of figures + interpolation:
#                          each figure is an Array[Real] of 2*verts
#                          coords; smoothstep easing; blend(a, b, t).
#                          Pure code, plus the figure constructors
#                          that allocate-and-fill an Array.
#   2. ===== STATE =====   the continuous phase clock the morph
#                          walks; select_figs decodes the
#                          (a_idx, b_idx, t) for the current frame.
#   3. ===== VIEW  =====   raylib rendering: draw the polygon as
#                          edges + finger circles, draw the HUD.
#                          Reads the precomputed point buffer; never
#                          mutates state.
#
# Controls:
#   SPACE  pause / resume
#   →      next figure
#   ←      previous figure
#   R      restart
#   ESC    quit

import ffi.raylib
import ffi.keys
import loop
import array
import math.real

# ============================================================
#  1. ===== MODEL ===============================================
#
#  Library of figures (kona / honu / vaka / moai / rapa), the
#  smoothstep easing function, and the per-frame `blend` that
#  interpolates two figures vertex-by-vertex. Pure logic — feed
#  it numbers, get an Array[Real] back.
# ============================================================

const verts : Int = 12  # vertices per figure

const n_figs : Int = 5

# Helper for figure constructors that need explicit (i, x, y)
# placement. Mutates `f` (a freshly-allocated array — `Mutable`
# is just the row, not an observable side-effect since `f`
# returns to the caller).
fn set_vertex(f: Array[Real], i: Int, x: Real, y: Real) : Unit / Mutable {
  f[i * 2] := x
  f[i * 2 + 1] := y
}

# Kona: the relaxed cord, a regular circle.
fn fig_kona() : Array[Real] / Ffi + Mutable {
  let f = array_make(verts * 2, 0.0)
  var i := 0
  repeat(verts) {
    let theta = 6.2831853 * int_to_real(i) / int_to_real(verts)
    f[i * 2] := raylib.cos(theta)
    f[i * 2 + 1] := raylib.sin(theta)
    i := i + 1
  }
  f
}

# Honu (turtle): hexagonal shell with head, tail and flippers.
fn fig_honu() : Array[Real] / Mutable {
  let f = array_make(verts * 2, 0.0)
  set_vertex(f, 0, 0.00, -0.95)
  set_vertex(f, 1, 0.55, -0.55)
  set_vertex(f, 2, 0.95, -0.30)
  set_vertex(f, 3, 0.70, 0.00)
  set_vertex(f, 4, 0.95, 0.45)
  set_vertex(f, 5, 0.55, 0.55)
  set_vertex(f, 6, 0.00, 0.95)
  set_vertex(f, 7, -0.55, 0.55)
  set_vertex(f, 8, -0.95, 0.45)
  set_vertex(f, 9, -0.70, 0.00)
  set_vertex(f, 10, -0.95, -0.30)
  set_vertex(f, 11, -0.55, -0.55)
  f
}

# Vaka (canoe): elongated silhouette, bow down and stern up.
fn fig_vaka() : Array[Real] / Mutable {
  let f = array_make(verts * 2, 0.0)
  set_vertex(f, 0, 0.00, -1.10)
  set_vertex(f, 1, 0.30, -0.55)
  set_vertex(f, 2, 0.45, -0.10)
  set_vertex(f, 3, 0.85, 0.00)
  set_vertex(f, 4, 0.45, 0.10)
  set_vertex(f, 5, 0.30, 0.55)
  set_vertex(f, 6, 0.00, 1.10)
  set_vertex(f, 7, -0.30, 0.55)
  set_vertex(f, 8, -0.45, 0.10)
  set_vertex(f, 9, -0.85, 0.00)
  set_vertex(f, 10, -0.45, -0.10)
  set_vertex(f, 11, -0.30, -0.55)
  f
}

# Moai: large head on top, pronounced shoulders.
fn fig_moai() : Array[Real] / Mutable {
  let f = array_make(verts * 2, 0.0)
  set_vertex(f, 0, 0.00, -1.00)
  set_vertex(f, 1, 0.45, -0.85)
  set_vertex(f, 2, 0.55, -0.45)
  set_vertex(f, 3, 0.45, -0.10)
  set_vertex(f, 4, 0.85, -0.05)
  set_vertex(f, 5, 0.75, 0.95)
  set_vertex(f, 6, 0.00, 1.00)
  set_vertex(f, 7, -0.75, 0.95)
  set_vertex(f, 8, -0.85, -0.05)
  set_vertex(f, 9, -0.45, -0.10)
  set_vertex(f, 10, -0.55, -0.45)
  set_vertex(f, 11, -0.45, -0.85)
  f
}

# Rapa: six-pointed star (alternating radii).
fn fig_rapa() : Array[Real] / Ffi + Mutable {
  let f = array_make(verts * 2, 0.0)
  var i := 0
  repeat(verts) {
    let theta = 6.2831853 * int_to_real(i) / int_to_real(verts)
    let r = if i % 2 == 0 { 1.05 } else { 0.45 }
    f[i * 2] := r * raylib.cos(theta)
    f[i * 2 + 1] := r * raylib.sin(theta)
    i := i + 1
  }
  f
}

fn figure_name(i: Int) : String {
  case 0 -> "kona  (el cordel)"
  case 1 -> "honu  (la tortuga)"
  case 2 -> "vaka  (la canoa)"
  case 3 -> "moai  (la estatua)"
  case _ -> "rapa  (la estrella)"
}

# ----- easing -----
#
# Smoothstep on [0,1]. Eases the start and end of the morph so it
# looks like a hand pulling the cord, not a teleport.
fn smoothstep(t: Real) : Real {
  let tt = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t }
  tt * tt * (3.0 - 2.0 * tt)
}

# Blend figures a and b into `out` by factor t in [0,1].
fn blend(
  a: Array[Real],
  b: Array[Real],
  t: Real,
  out: Array[Real]
) : Unit / Mutable {
  var i := 0
  repeat(verts * 2) {
    out[i] := a[i] + t * (b[i] - a[i])
    i := i + 1
  }
}

# ============================================================
#  2. ===== STATE ===============================================
#
#  The phase clock is a continuous Real that walks `[0, n_figs)`
#  mod n_figs as time advances; each integer step is a figure
#  transition. `select_figs` decodes the current (a_idx, b_idx, t)
#  from the phase and writes the blended point buffer.
# ============================================================

const morph_secs : Real = 2.5  # transition time between figures

const hold_secs : Real = 1.2  # hold time on each figure

const spin_rate : Real = 0.35  # global rotation, radians per second

# Resolve the current (a_idx, b_idx, t) from the phase clock,
# blend the two figures into `out`, and return the triple. The
# first `hold_frac` of each cycle is a static hold; the rest is a
# smoothstep morph toward the next figure.
fn select_figs(
  phase: Real,
  figs: Array[Array[Real]],
  out: Array[Real]
) : (Int, Int, Real) / Mutable {
  let cycle = morph_secs + hold_secs
  let hold_frac = hold_secs / cycle

  let p = phase - real.floor(phase / int_to_real(n_figs)) * int_to_real(n_figs)
  let a_idx = real_to_int(real.floor(p))
  let b_idx = (a_idx + 1) % n_figs
  let local = p - int_to_real(a_idx)  # [0,1)

  let t_raw =
    if local < hold_frac {
      0.0
    } else {
      (local - hold_frac) / (1.0 - hold_frac)
    }
  let t = smoothstep(t_raw)

  blend(figs[a_idx], figs[b_idx], t, out)
  (a_idx, b_idx, t)
}

# ============================================================
#  3. ===== VIEW ================================================
#
#  raylib rendering. Local-frame points become world-frame via a
#  global rotation `spin` and a fixed scale + center; the polygon
#  is drawn as a closed loop of line segments, with a small
#  circle on each vertex (the "fingers" holding the cord).
# ============================================================

const width : Int = 800

const height : Int = 600

const cx : Real = 400.0

const cy : Real = 320.0

const scale : Real = 180.0  # local units -> pixels

const col_bg : Color = rgba(0x0a1418FF)

const col_cord : Color = rgba(0xfdf9b9FF)

const col_finger : Color = rgba(0xff6f59FF)

const col_text : Color = rgba(0xfdf9b9FF)

const col_dim : Color = rgba(0x6b6f5cFF)

# Project a local-frame (lx, ly) to world space, given the global
# rotation (ct, st) = (cos spin, sin spin).
fn world_xy(lx: Real, ly: Real, ct: Real, st: Real) : (Real, Real) =
  (cx + scale * (ct * lx - st * ly), cy + scale * (st * lx + ct * ly))

fn draw_figure(pts: Array[Real], spin: Real) : Unit / Ffi {
  let ct = raylib.cos(spin)
  let st = raylib.sin(spin)

  # Edges of the closed polygon.
  var i := 0
  repeat(verts) {
    let j = (i + 1) % verts
    let (ax, ay) = world_xy(pts[i * 2], pts[i * 2 + 1], ct, st)
    let (bx, by) = world_xy(pts[j * 2], pts[j * 2 + 1], ct, st)
    raylib.draw_line(
      real_to_int(ax),
      real_to_int(ay),
      real_to_int(bx),
      real_to_int(by),
      col_cord
    )
    i := i + 1
  }

  # "Finger" circles on each vertex.
  i := 0
  repeat(verts) {
    let (x, y) = world_xy(pts[i * 2], pts[i * 2 + 1], ct, st)
    raylib.draw_circle(
      real_to_int(x),
      real_to_int(y),
      4.0,
      col_finger
    )
    i := i + 1
  }
}

fn draw_hud(a_idx: Int, b_idx: Int, t: Real, paused: Bool) : Unit / Ffi {
  raylib.draw_text(
    "kaikai rapanui / kaikai + raylib",
    10,
    10,
    22,
    col_text
  )
  raylib.draw_text(
    "SPACE pausa   <- ->  cambiar figura   R reiniciar   ESC salir",
    10,
    568,
    18,
    col_dim
  )

  raylib.draw_text("figura:", 20, 525, 20, col_dim)
  raylib.draw_text(figure_name(a_idx), 110, 525, 20, col_text)

  if t > 0.0 {
    raylib.draw_text("->", 430, 525, 20, col_dim)
    raylib.draw_text(figure_name(b_idx), 470, 525, 20, col_text)
  }

  let label = if paused { "PAUSADO" } else { "fps" }
  raylib.draw_text(label, 660, 10, 20, col_text)
  if not paused {
    raylib.draw_text(int_to_string(raylib.get_fps()), 720, 10, 20, col_text)
  }
}

# ============================================================
#  ===== ORCHESTRATOR ===========================================
#
#  `phase` is the continuous clock in figure-units. It advances
#  by dt each frame; arrows snap ±1 figure to the morph boundary.
# ============================================================

fn frame_loop(figs: Array[Array[Real]], pts: Array[Real]) : Unit / Ffi + Mutable {
  var phase := 0.0
  var paused := false
  var prev_time := raylib.get_time()
  var spin := 0.0

  let cycle = morph_secs + hold_secs

  until { raylib.window_should_close() } {
    # ---- input ----
    let now = raylib.get_time()
    let dt = now - prev_time
    prev_time := now

    if raylib.is_key_pressed(key_space) {
      paused := not paused
    }
    if raylib.is_key_pressed(key_r) {
      phase := 0.0
      spin := 0.0
    }
    if raylib.is_key_pressed(key_right) {
      phase := real.floor(phase) + 1.0
    }
    if raylib.is_key_pressed(key_left) {
      let cur = real_to_int(real.floor(phase))
      let prev = if cur == 0 { n_figs - 1 } else { cur - 1 }
      phase := int_to_real(prev)
    }

    # ---- STATE: tick the phase clock ----
    if not paused {
      phase := phase + dt / cycle
      spin := spin + dt * spin_rate
    }

    # ---- MODEL: blend the current pair of figures ----
    let (a_idx, b_idx, t) = select_figs(phase, figs, pts)

    # ---- VIEW: render ----
    raylib.begin_drawing()
    raylib.clear_background(col_bg)
    draw_figure(pts, spin)
    draw_hud(a_idx, b_idx, t, paused)
    raylib.end_drawing()
  }
}

fn main() : Unit / Ffi + Mutable {
  let figs = array.from([fig_kona(), fig_honu(), fig_vaka(), fig_moai(), fig_rapa()])
  let pts = array_make(verts * 2, 0.0)

  raylib.init_window(width, height, "Kaikai rapanui / kaikai + raylib")
  raylib.set_target_fps(60)
  frame_loop(figs, pts)
  raylib.close_window()
}
