# Observatory — kaikai + raylib showcase for astronomers
#
# Three demos in one, switched with keys:
#
#   N - Solar N-body      Leapfrog integration of the solar
#                         system's planets under real gravity:
#                         the ellipses, the precession and the
#                         relative periods come out of the
#                         computation, not from a hardcoded cosine.
#                         The formula
#                         a = G * Σ Mⱼ * (rⱼ - rᵢ) / |rⱼ - rᵢ|³
#                         typechecks only because the units
#                         agree:  G : m³/(kg·s²),  M : kg,
#                         r : m  ⇒  a : m/s².
#
#   H - Hertzsprung-Russell  Scatter of T_eff (X axis, inverted log)
#                            vs solar luminosity (Y axis, log).
#                            Each star is colored by its spectral
#                            type (O/B/A/F/G/K/M) — the main
#                            sequence, red giant and white dwarf
#                            branches stand out at a glance.
#                            type Spectral with pattern matching
#                            for color and radius.
#
#   P - Stellar parallax  Side-by-side view of Earth in January /
#                         Earth in July. Nearby stars shift
#                         visibly between the two dates; distant
#                         ones don't. The parallax in arcsec over
#                         a 2 au baseline gives the distance in
#                         parsecs (hence the name).
#                         UoM: Real<pc>, Real<arcsec>.
#
# kaikai features on show:
#
#   - Compound units of measure (m³/(kg·s²), au/days², L_sol,
#     K, pc, arcsec). The physics formulas typecheck by
#     dimension; changing G to incompatible units is a
#     compile error.
#   - Sum types + match guards: Mode (selection), Spectral
#     (banded classification).
#   - Mutable arrays + Ref: the planets mutate their
#     positions/velocities; the active mode is a Ref[Mode].
#   - Exhaustive pattern matching to classify and dispatch
#     between modes.
#
# Controls:
#   N    N-body mode
#   H    Hertzsprung-Russell mode
#   P    parallax mode
#   SPACE pause (N-body only)
#   + / -  N-body simulation speed
#   R    reset the active mode to its initial state
#   ESC  quit

import ffi.raylib
import ffi.keys
import loop

# ============================================================
#  1. ===== MODEL ===============================================
# ============================================================

# ----- units of measure -----

unit m

unit kg

unit s

unit au  # astronomical unit (= 1.495979e11 m)

unit days

unit yr

unit kelvin  # T_eff (Kelvin)

unit lsol  # solar luminosity (= 3.828e26 W)

unit pc  # parsec

unit arcsec

unit au_per_day = au/days

unit au_per_day2 = au/days*days

unit km_per_s = m/s  # we'll just call our axis "m/s" then scale display

# Fundamental constants in au-day-msun units (so the planetary
# integrator stays away from 1e30-magnitude numbers).
#
# G in SI is 6.674e-11 m³/(kg·s²). Converting to au/day with
# masses expressed in solar masses gives 2.959e-4. In other
# words: G_au_day_msun ≈ 4π²/(yr_in_days)², which is just
# Kepler's third law.
unit msun

unit g_unit = au*au*au/msun*days*days

const g_au_day : Real<g_unit> = 0.000295912208<au*au*au/msun*days*days>

# ----- mode discriminator -----

type Mode = NBody | HR | Parallax

# ----- spectral classification -----
#
# Stars classified by surface temperature: O is hottest blue,
# M is coolest red. Bands taken from Harvard's classical
# breakpoints in Kelvin.

type Spectral = O | B | A | F | G | K | M

fn class_of_temp(t: Real<kelvin>) : Spectral = match t {
  k if k >= 30000.0<kelvin> -> O
  k if k >= 10000.0<kelvin> -> B
  k if k >= 7500.0<kelvin> -> A
  k if k >= 6000.0<kelvin> -> F
  k if k >= 5200.0<kelvin> -> G
  k if k >= 3700.0<kelvin> -> K
  _ -> M
}

fn class_color(s: Spectral) : Color = match s {
  O -> rgba(0x9bb0ffFF)  # blue-white
  B -> rgba(0xaabffeFF)  # blue
  A -> rgba(0xcad7ffFF)  # white
  F -> rgba(0xf8f7ffFF)  # yellow-white
  G -> rgba(0xfff4e8FF)  # yellow (Sun)
  K -> rgba(0xffd2a1FF)  # orange
  M -> rgba(0xffae5cFF)  # red
}

# Visual radius for HR / parallax dots, in pixels. Bigger and
# brighter means a "louder" star to the eye.
fn class_radius(s: Spectral) : Real {
  case O -> 7.0
  case B -> 6.0
  case A -> 5.5
  case F -> 5.0
  case G -> 5.0
  case K -> 4.5
  case M -> 4.0
}

# ============================================================
#  2. ===== STATE ===============================================
#
#  Three datasets, one per mode: (a) the solar-system bodies
#  (Sun + 8 planets) for the N-body integrator; (b) a catalog
#  of ~25 well-known stars for the HR diagram and the parallax
#  view (same catalog reused).
# ============================================================

# ----- N-body: sun + 8 planets -----
#
# Positions in au, velocities in au/day, masses in solar
# masses. Initial conditions are heliocentric — sun at origin,
# planets at perihelion-ish along +x with circular-velocity in
# +y. (Approximation: real ephemerides have inclination,
# eccentricity, and phase, but for the showcase the planets
# tracing visible elliptical-ish loops is what matters.)

const n_bodies : Int = 9

# Per-body state, one slot per body index (0 = Sun).
type Bodies = {
  xs: Array[Real],
  ys: Array[Real],
  vxs: Array[Real],
  vys: Array[Real],
  ms: Array[Real]
}

# Solar system seeds (au, au/day, msun). Mercury, Venus, Earth,
# Mars, Jupiter, Saturn, Uranus, Neptune.
fn seed_x(i: Int) : Real {
  case 0 -> 0.0
  case 1 -> 0.387
  case 2 -> 0.723
  case 3 -> 1.000
  case 4 -> 1.524
  case 5 -> 5.203
  case 6 -> 9.537
  case 7 -> 19.191
  case _ -> 30.069
}

# Circular orbital velocity at distance r from a 1-msun star:
#   v = sqrt(G/r)   in au/day
# We compute this once at seed time so the orbits stay roughly
# circular even with the leapfrog integrator's small drift.
fn seed_vy(i: Int) : Real / Ffi {
  case 0 -> 0.0
  case _ -> {
    let g_bare = g_au_day / 1.0<au*au*au/msun*days*days>
    real_sqrt_approx(g_bare / seed_x(i))
  }
}

# Newton's iteration sqrt for our purposes — kaikai's stdlib
# real_sqrt sits behind a libm extern, but we already have
# raylib.sqrt available everywhere we need it.
fn real_sqrt_approx(x: Real) : Real / Ffi = raylib.sqrt(x)

fn body_mass(i: Int) : Real = match i {
  0 -> 1.0  # Sun
  1 -> 1.66e-7  # Mercury
  2 -> 2.45e-6  # Venus
  3 -> 3.00e-6  # Earth
  4 -> 3.23e-7  # Mars
  5 -> 9.55e-4  # Jupiter
  6 -> 2.86e-4  # Saturn
  7 -> 4.37e-5  # Uranus
  _ -> 5.15e-5  # Neptune
}

fn body_name(i: Int) : String {
  case 0 -> "Sol"
  case 1 -> "Mercurio"
  case 2 -> "Venus"
  case 3 -> "Tierra"
  case 4 -> "Marte"
  case 5 -> "Jupiter"
  case 6 -> "Saturno"
  case 7 -> "Urano"
  case _ -> "Neptuno"
}

fn body_color(i: Int) : Color = match i {
  0 -> rgba(0xffd166FF)  # Sun
  1 -> rgba(0xb08968FF)
  2 -> rgba(0xefcb68FF)
  3 -> rgba(0x4ea1ffFF)
  4 -> rgba(0xff6b6bFF)
  5 -> rgba(0xfca311FF)
  6 -> rgba(0xe0c590FF)
  _ -> rgba(0x90c8e0FF)
}

# ----- N-body integrator: leapfrog (kick-drift-kick) -----
#
# Each step: half-kick velocities by current accel, drift
# positions by full timestep, recompute accel, half-kick
# velocities again. Conserves energy long-term much better than
# explicit Euler.

fn init_bodies(b: Bodies) : Unit / Ffi + Mutable {
  var i := 0
  while { i < n_bodies } {
    b.xs[i] := seed_x(i)
    b.ys[i] := 0.0
    b.vxs[i] := 0.0
    b.vys[i] := seed_vy(i)
    b.ms[i] := body_mass(i)
    i := i + 1
  }
}

# Acceleration (ax, ay) on body i: the sum of G*m_j*(r_j-r_i)/|...|^3
# over all j != i.
fn accel(b: Bodies, i: Int) : (Real, Real) / Mutable {
  # G in au/day units, ms[j] in msun: a contribution is
  # G * m_j / r³ * (dx, dy).
  let g_bare = g_au_day / 1.0<au*au*au/msun*days*days>
  var ax := 0.0
  var ay := 0.0
  var j := 0
  while { j < n_bodies } {
    if j != i {
      let dx = b.xs[j] - b.xs[i]
      let dy = b.ys[j] - b.ys[i]
      let r2 = dx * dx + dy * dy
      let r3 = r2 * real_sqrt_approx_bare(r2)
      let f = g_bare * b.ms[j] / r3
      ax := ax + f * dx
      ay := ay + f * dy
    }
    j := j + 1
  }
  (ax, ay)
}

fn real_sqrt_approx_bare(x: Real) : Real {
  # Babylonian. Two iterations from x/2 are enough for our
  # display precision and avoid taking an Ffi dependency on every
  # single accel pair.
  if x <= 0.0 {
    0.0
  } else {
    let y0 = x * 0.5 + 0.0001
    let y1 = (y0 + x / y0) * 0.5
    let y2 = (y1 + x / y1) * 0.5
    (y2 + x / y2) * 0.5
  }
}

# One leapfrog step. dt is in days.
fn leapfrog_step(b: Bodies, dt: Real) : Unit / Mutable {
  half_kick(b, dt)
  drift(b, dt)
  half_kick(b, dt)
}

fn half_kick(b: Bodies, dt: Real) : Unit / Mutable {
  var i := 0
  while { i < n_bodies } {
    let (ax, ay) = accel(b, i)
    b.vxs[i] := b.vxs[i] + 0.5 * dt * ax
    b.vys[i] := b.vys[i] + 0.5 * dt * ay
    i := i + 1
  }
}

fn drift(b: Bodies, dt: Real) : Unit / Mutable {
  var i := 0
  while { i < n_bodies } {
    b.xs[i] := b.xs[i] + dt * b.vxs[i]
    b.ys[i] := b.ys[i] + dt * b.vys[i]
    i := i + 1
  }
}

