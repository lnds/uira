# ============================================================
#  3. ===== VIEW ================================================
# ============================================================

const width : Int = 1100

const height : Int = 700

const col_bg : Color = rgba(0x06080cFF)

const col_panel : Color = rgba(0x101620FF)

const col_text : Color = rgba(0xeaedf3FF)

const col_dim : Color = rgba(0x6b7382FF)

const col_accent : Color = rgba(0xfca311FF)

const col_grid : Color = rgba(0x1a2030FF)

# A screen-space rectangle in pixels.
type Panel = { x: Int, y: Int, w: Int, h: Int }

fn fill_rect(r: Panel, c: Color) : Unit / Ffi = raylib.draw_rectangle(r.x, r.y, r.w, r.h, c)

# ----- mode N-body view -----

const cx : Real = 550.0

const cy : Real = 380.0

# Pixels per au — log-ish so we can show inner planets and
# Jupiter+ at the same time without one or the other vanishing.
fn px_per_au(scale: Real) : Real = scale

fn draw_nbody(
  font: Font,
  b: Bodies,
  trails: Array[Real],
  head: Int,
  scale: Real,
  sim_days: Real
) : Unit / Ffi {
  let s = px_per_au(scale)

  # Trails (rings of past positions per body).
  draw_trails(trails, head, s)

  # Bodies.
  draw_bodies(font, b, s)

  # HUD.
  raylib.draw_text_ex(
    font,
    "MODO  N-body solar (gravedad real, leapfrog Verlet)",
    24,
    18,
    26,
    1.0,
    col_text
  )
  raylib.draw_text_ex(font, "dia simulado:", 24, 60, 20, 1.0, col_dim)
  raylib.draw_text_ex(font, int_to_string(real_to_int(sim_days)), 180, 60, 20, 1.0, col_text)
  raylib.draw_text_ex(font, "escala (au -> px):", 320, 60, 20, 1.0, col_dim)
  raylib.draw_text_ex(font, real_to_string(scale), 510, 60, 20, 1.0, col_text)
}

fn draw_bodies(font: Font, b: Bodies, s: Real) : Unit / Ffi {
  var i := 0
  while { i < n_bodies } {
    let x = real_to_int(cx + b.xs[i] * s)
    let y = real_to_int(cy + b.ys[i] * s)
    if i == 0 {
      raylib.draw_circle(x, y, 10.0, body_color(i))
    } else {
      let r = if b.ms[i] > 0.0001 { 5.0 } else { 3.5 }  # gas giants bigger
      raylib.draw_circle(x, y, r, body_color(i))
      raylib.draw_text_ex(font, body_name(i), x + 8, y - 8, 16, 1.0, col_dim)
    }
    i := i + 1
  }
}

# Ring buffer of past positions: body i owns `trail_len` (x, y)
# slots starting at i * trail_len * 2. An all-zero slot is unused.
const trail_len : Int = 128

fn record_trails(trails: Array[Real], b: Bodies, head_ref: Ref[Int]) : Unit / Mutable {
  let h = @head_ref
  var i := 0
  while { i < n_bodies } {
    let base = i * trail_len * 2
    trails[base + h * 2] := b.xs[i]
    trails[base + h * 2 + 1] := b.ys[i]
    i := i + 1
  }
  head_ref := (h + 1) % trail_len
}

fn draw_trails(trails: Array[Real], head: Int, s: Real) : Unit / Ffi {
  var i := 1  # skip Sun (i=0)
  while { i < n_bodies } {
    draw_trail(trails, head, s, i)
    i := i + 1
  }
}

fn draw_trail(trails: Array[Real], head: Int, s: Real, i: Int) : Unit / Ffi {
  let base = i * trail_len * 2
  var k := 0
  while { k < trail_len - 1 } {
    let off1 = (head + k) % trail_len
    let off2 = (head + k + 1) % trail_len
    let x1r = trails[base + off1 * 2]
    let y1r = trails[base + off1 * 2 + 1]
    let x2r = trails[base + off2 * 2]
    let y2r = trails[base + off2 * 2 + 1]
    if (x1r != 0.0 or y1r != 0.0) and (x2r != 0.0 or y2r != 0.0) {
      raylib.draw_line(
        real_to_int(cx + x1r * s),
        real_to_int(cy + y1r * s),
        real_to_int(cx + x2r * s),
        real_to_int(cy + y2r * s),
        raylib.rgba(0x303040FF)
      )
    }
    k := k + 1
  }
}

# ----- mode HR view -----
#
# X axis: log10(T_eff) inverted (high temp left). Y axis:
# log10(L / L_sun). Both with grid lines and labels.

fn log10_approx(x: Real) : Real {
  # ln(x)/ln(10), with ln from a coarse Taylor around the mean.
  # Good enough for axis placement.
  if x <= 0.0 {
    -99.0
  } else {
    ln_approx(x) / 2.302585
  }
}

fn ln_approx(x: Real) : Real {
  # Reduce x = 2^k * m with m in [1,2), then ln x = k*ln2 + ln m.
  # ln m via two terms of (m-1) - (m-1)²/2 is enough for axes.
  let r = reduce_pow2(x, 0)
  let k = r / 1000000.0  # encoded above as k * 1e6 + m_minus_1
  let m_minus_1 = r - k * 1000000.0 - 1.0
  k * 0.693147 + m_minus_1 - m_minus_1 * m_minus_1 * 0.5
}

# Encode (k, m) into one Real to avoid building a tuple. Hacky
# but the demo only needs axis labels.
fn reduce_pow2(x: Real, k: Int) : Real {
  if x >= 2.0 {
    reduce_pow2(x * 0.5, k + 1)
  } else if x < 1.0 {
    reduce_pow2(x * 2.0, k - 1)
  } else {
    int_to_real(k) * 1000000.0 + x
  }
}

const hr_plot : Panel = Panel { x: 110, y: 110, w: 880, h: 510 }

fn draw_hr(font: Font) : Unit / Ffi {
  raylib.draw_text_ex(
    font,
    "MODO  Diagrama Hertzsprung-Russell",
    24,
    18,
    26,
    1.0,
    col_text
  )
  raylib.draw_text_ex(
    font,
    "eje X: temperatura (K) decreciente   eje Y: luminosidad (L_sol)",
    24,
    56,
    18,
    1.0,
    col_dim
  )

  # Plot area.
  fill_rect(hr_plot, col_panel)

  # Grid lines: temp at 30000, 10000, 7500, 6000, 5200, 3700.
  draw_hr_grid(font, hr_plot)

  # Plot the catalog.
  draw_hr_stars(font, hr_plot)
}

# Map T_eff (K) to X. Inverted log scale: hot stars on the left.
# Domain: [2500, 35000] K ⇒ [p.x + p.w, p.x] (right to left).
fn temp_to_x(t: Real, p: Panel) : Int {
  let lo = 2500.0
  let hi = 35000.0
  let lt = log10_approx(t)
  let llo = log10_approx(lo)
  let lhi = log10_approx(hi)
  let frac = (lt - llo) / (lhi - llo)
  # Inverted: high temp -> small frac complement -> left.
  real_to_int(int_to_real(p.x) + (1.0 - frac) * int_to_real(p.w))
}

# Map L (Lsun) to Y. Domain: [1e-4, 1e6] ⇒ [p.y + p.h, p.y].
fn lum_to_y(l: Real, p: Panel) : Int {
  let lo = 0.0001
  let hi = 1000000.0
  let ll = log10_approx(l)
  let llo = log10_approx(lo)
  let lhi = log10_approx(hi)
  let frac = (ll - llo) / (lhi - llo)
  real_to_int(int_to_real(p.y) + (1.0 - frac) * int_to_real(p.h))
}

fn draw_hr_grid(font: Font, p: Panel) : Unit / Ffi {
  # Temperature grid lines at the Harvard breakpoints.
  draw_temp_line(font, p, 30000.0, "30000K  O")
  draw_temp_line(font, p, 10000.0, "10000K  B")
  draw_temp_line(font, p, 7500.0, "7500K  A")
  draw_temp_line(font, p, 6000.0, "6000K  F")
  draw_temp_line(font, p, 5200.0, "5200K  G")
  draw_temp_line(font, p, 3700.0, "3700K  K")

  # Luminosity grid lines per decade.
  draw_lum_line(font, p, 0.0001, "1e-4 L")
  draw_lum_line(font, p, 0.01, "1e-2 L")
  draw_lum_line(font, p, 1.0, "  1  L")
  draw_lum_line(font, p, 100.0, "100  L")
  draw_lum_line(font, p, 10000.0, "1e4 L")
  draw_lum_line(font, p, 1000000.0, "1e6 L")
}

fn draw_temp_line(font: Font, p: Panel, t: Real, label: String) : Unit / Ffi {
  let x = temp_to_x(t, p)
  raylib.draw_rectangle(x, p.y, 1, p.h, col_grid)
  raylib.draw_text_ex(font, label, x - 38, p.y + p.h + 6, 14, 1.0, col_dim)
}

fn draw_lum_line(font: Font, p: Panel, l: Real, label: String) : Unit / Ffi {
  let y = lum_to_y(l, p)
  raylib.draw_rectangle(p.x, y, p.w, 1, col_grid)
  raylib.draw_text_ex(font, label, p.x - 70, y - 8, 14, 1.0, col_dim)
}

fn draw_hr_stars(font: Font, p: Panel) : Unit / Ffi {
  var i := 0
  while { i < n_stars } {
    let t = star_temp(i)
    let s = class_of_temp(t)
    let x = temp_to_x(t / 1.0<kelvin>, p)
    let y = lum_to_y(star_lum(i) / 1.0<lsol>, p)
    raylib.draw_circle(x, y, class_radius(s), class_color(s))
    # Label only the famous ones to keep the plot legible.
    if i <= 6 or i == 11 or i == 17 {
      raylib.draw_text_ex(font, star_name(i), x + 10, y - 8, 16, 1.0, col_text)
    }
    i := i + 1
  }
}

# ----- mode parallax view -----
#
# Two side-by-side sky panels: the same star catalog as seen
# from Earth in January and from Earth in July (6 months apart,
# Earth has moved 2 au across the orbit). Nearby stars shift
# visibly between the two panels; far stars don't.

const pan_left : Panel = Panel { x: 30, y: 120, w: 510, h: 510 }

const pan_right : Panel = Panel { x: 560, y: 120, w: 510, h: 510 }

const parallax_gain : Real = 80.0  # visual amplification

const arcsec_to_px : Real = 1.0  # base scale

# Project a star into a panel given the observer's `obs_x` (the
# x-coordinate in au of Earth at the observation moment, in
# heliocentric coords). The shift due to parallax is
# Δθ ≈ obs_x / d  (radians, small-angle).
#
# We project the unshifted RA/Dec into the panel first, then
# nudge by the parallax shift in the X axis.
fn project_star(font: Font, i: Int, obs_x: Real, p: Panel) : Unit / Ffi {
  # Base (RA, Dec) in flat-sky coords. RA: [0,24h] -> [0, p.w].
  let base_x = int_to_real(p.x) + star_ra_h(i) / 24.0 * int_to_real(p.w)
  let base_y = int_to_real(p.y) + (90.0 - star_dec_deg(i)) / 180.0 * int_to_real(p.h)

  # Parallax shift, scaled visually so it's visible. Real shift
  # for nearest stars is ~1 arcsec; we amplify by `parallax_gain`.
  let d_pc = star_distance(i) / 1.0<pc>
  let shift_arcsec = obs_x / d_pc * parallax_gain
  let shift_px = shift_arcsec * arcsec_to_px

  let x = real_to_int(base_x + shift_px)
  let y = real_to_int(base_y)

  let s = class_of_temp(star_temp(i))
  raylib.draw_circle(x, y, class_radius(s), class_color(s))
  if i <= 9 or i == 21 or i == 22 {
    raylib.draw_text_ex(font, star_name(i), x + 8, y - 10, 13, 1.0, col_dim)
  }
}

fn draw_parallax(font: Font) : Unit / Ffi {
  raylib.draw_text_ex(
    font,
    "MODO  Paralaje estelar",
    24,
    18,
    26,
    1.0,
    col_text
  )
  raylib.draw_text_ex(
    font,
    "estrellas cercanas se desplazan entre enero y julio   |   base: 2 au   ganancia visual: 80x",
    24,
    56,
    16,
    1.0,
    col_dim
  )

  # Panels.
  fill_rect(pan_left, col_panel)
  fill_rect(pan_right, col_panel)
  raylib.draw_text_ex(
    font,
    "Enero  (Tierra a -1 au)",
    pan_left.x + 8,
    pan_left.y - 26,
    18,
    1.0,
    col_text
  )
  raylib.draw_text_ex(
    font,
    "Julio  (Tierra a +1 au)",
    pan_right.x + 8,
    pan_right.y - 26,
    18,
    1.0,
    col_text
  )

  # Stars in each panel.
  draw_parallax_stars(font, pan_left, -1.0)
  draw_parallax_stars(font, pan_right, 1.0)
}

fn draw_parallax_stars(font: Font, p: Panel, obs_x: Real) : Unit / Ffi {
  var i := 0
  while { i < n_stars } {
    project_star(font, i, obs_x, p)
    i := i + 1
  }
}

# ----- footer -----

fn draw_footer(font: Font) : Unit / Ffi {
  let y = height - 50
  raylib.draw_rectangle(0, y, width, 50, col_panel)
  raylib.draw_text_ex(
    font,
    "N  N-body     H  HR diagram     P  Paralaje     SPACE pausa     + -  velocidad     R reset     ESC salir",
    24,
    y + 16,
    17,
    1.0,
    col_dim
  )
}

# ============================================================
#  ===== ORCHESTRATOR ===========================================
# ============================================================

# Everything the frame loop mutates.
type Sim = {
  bodies: Bodies,
  trails: Array[Real],
  trail_head: Ref[Int],
  mode: Ref[Mode],
  paused: Ref[Bool],
  dt: Ref[Real],  # days per step
  sim_days: Ref[Real],
  scale: Ref[Real]  # px per au
}

fn frame_loop(font: Font, sim: Sim) : Unit / Ffi + Mutable {
  until { raylib.window_should_close() } {
    # ---- input ----
    if raylib.is_key_pressed(key_n) { sim.mode := NBody }
    if raylib.is_key_pressed(key_h) { sim.mode := HR }
    if raylib.is_key_pressed(key_p) { sim.mode := Parallax }
    if raylib.is_key_pressed(key_space) { sim.paused := not (@sim.paused) }
    if raylib.is_key_pressed(key_equal) { sim.dt := (@sim.dt) * 1.5 }
    if raylib.is_key_pressed(key_minus) { sim.dt := (@sim.dt) / 1.5 }
    if raylib.is_key_pressed(key_r) { reset_for_mode(@sim.mode, sim) }

    # ---- STATE: tick the active mode ----
    let m = @sim.mode
    if not (@sim.paused) { tick_mode(m, sim) }

    # ---- VIEW: render the active mode ----
    raylib.begin_drawing()
    raylib.clear_background(col_bg)
    render_mode(font, m, sim.bodies, sim.trails, @sim.trail_head, @sim.scale, @sim.sim_days)
    draw_footer(font)
    raylib.end_drawing()
  }
}

fn reset_for_mode(m: Mode, sim: Sim) : Unit / Ffi + Mutable = match m {
  NBody -> {
    init_bodies(sim.bodies)
    sim.sim_days := 0.0
    sim.dt := 1.0
    sim.scale := 28.0
  }
  HR -> ()
  Parallax -> ()
}

fn tick_mode(m: Mode, sim: Sim) : Unit / Mutable = match m {
  NBody -> {
    leapfrog_step(sim.bodies, @sim.dt)
    record_trails(sim.trails, sim.bodies, sim.trail_head)
    sim.sim_days := (@sim.sim_days) + (@sim.dt)
  }
  HR -> ()
  Parallax -> ()
}

fn render_mode(
  font: Font,
  m: Mode,
  b: Bodies,
  trails: Array[Real],
  head: Int,
  scale: Real,
  sim_days: Real
) : Unit / Ffi = match m {
  NBody -> draw_nbody(font, b, trails, head, scale, sim_days)
  HR -> draw_hr(font)
  Parallax -> draw_parallax(font)
}

fn main() : Unit / Ffi + Mutable {
  raylib.set_random_seed(42)

  # N-body state.
  let bodies = Bodies {
    xs: array_make(n_bodies, 0.0),
    ys: array_make(n_bodies, 0.0),
    vxs: array_make(n_bodies, 0.0),
    vys: array_make(n_bodies, 0.0),
    ms: array_make(n_bodies, 0.0)
  }

  raylib.init_window(width, height, "Observatorio / kaikai + raylib")
  raylib.set_target_fps(60)

  # Load a smooth TTF at a generous pixel size so labels stay
  # crisp at the audience's distance. If the file is missing,
  # raylib falls back to its bitmap default (less pretty).
  let font = raylib.load_font("/System/Library/Fonts/Supplemental/Arial.ttf", 32)

  init_bodies(bodies)

  let sim = Sim {
    bodies: bodies,
    trails: array_make(n_bodies * trail_len * 2, 0.0),
    trail_head: &0,
    mode: &NBody,
    paused: &false,
    dt: &1.0,
    sim_days: &0.0,
    scale: &28.0
  }

  frame_loop(font, sim)
  raylib.unload_font(font)

  raylib.close_window()
}
